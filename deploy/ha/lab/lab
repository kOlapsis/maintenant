#!/bin/sh
# The HA bench, driven by one command.
#
#   lab up [--mode <mode>]   build the topology and deploy the mode
#   lab down                 destroy everything, leaving no residue
#   lab status [--json]      cluster, mode, probes and OpenSVC agent state
#   lab giveback             move the service back to the preferred node
#
# Contract: specs/030-ha-opensvc/contracts/lab-cli.md. No command ever asks a
# question: the bench is built, played and torn down unattended (FR-046).
#
# The topology is reached through the Ansible inventory and nothing else, so
# replaying the campaign on other machines changes LAB_INVENTORY and no line of
# this script (FR-053).
#
# POSIX sh. Needs ansible-core, jq and ssh; up and down also need virsh.
#
# Exit codes: 0 success, 1 the bench is not green, 2 usage, 3 command not
# implemented yet, 4 missing prerequisite.

set -eu

LAB_DIR=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
HA_DIR=$(dirname "$LAB_DIR")
ANSIBLE_DIR="$HA_DIR/ansible"
STATE_DIR="$LAB_DIR/.state"
INVENTORY="${LAB_INVENTORY:-$ANSIBLE_DIR/inventories/lab/hosts.yml}"

ANSIBLE_CONFIG="$ANSIBLE_DIR/ansible.cfg"
export ANSIBLE_CONFIG

LAB_SSH_KEY="${LAB_SSH_KEY:-$HOME/.ssh/id_ed25519}"
ANSIBLE_PRIVATE_KEY_FILE=$LAB_SSH_KEY
export LAB_SSH_KEY ANSIBLE_PRIVATE_KEY_FILE

DEFAULT_MODE="ip-only"
KNOWN_MODES="ip-only postgres/streaming sqlite/drbd postgres/drbd"

SSH_WAIT_TIMEOUT=300
SSH_BATCH_OPTS="-i $LAB_SSH_KEY -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"

# Domains are named after the machines, with the prefix the provisioning uses.
LAB_DOMAIN_PREFIX="${LAB_DOMAIN_PREFIX:-mnt-lab-}"

# The agents' authentication tolerance is 300 s; the bench refuses far earlier.
CLOCK_DRIFT_MAX=30

PROBE_AVAILABILITY_UNIT="lab-probe-availability.service"
PROBE_WRITES_UNIT="lab-probe-writes.service"
PROBE_OBSERVER_UNIT="lab-probe-observer.service"

PROBE_BIN_DIR="/usr/local/bin"
PROBE_ENV_FILE="/etc/default/lab-probes"

RUN_ALL_GREEN_TIMEOUT=300
RUN_ALL_GREEN_INTERVAL=5
RUN_ALL_VERIFY_TIMEOUT=180
RUN_ALL_VERIFY_INTERVAL=2
# The read-back pages through every ping since lab up, on a cache the failover left cold.
WRITES_VERIFY_TIMEOUT=30s
RUN_ALL_ABORTED=0
AGENTS_RECONNECT_MAX_S=90
PROBE_MEASURES='["rto_ms", "writes", "telemetry_gap_s", "telemetry_samples_lost", "alerts_induced", "agents"]'
NODE_MEASURES='["local_restarts", "failover_count", "detection_delay_s", "fencing_outcome", "agent_watchdog_restart", "primary_count", "former_primary_rebuild", "sync_standby", "loss_window", "crash_confirmed", "nodes_written", "divergence"]'
POSTGRES_MEASURES='["primary_count", "former_primary_rebuild", "sync_standby", "loss_window", "divergence"]'
SHARED_DATA_MEASURES='["writes", "telemetry_gap_s", "telemetry_samples_lost", "alerts_induced", "agents"]'
# Must match maintenant_check_log_identifier, the fencing callout and log_event of postgres_ha; systemd logs the watchdog kills.
NODE_EVENT_TAGS="maintenant-svc maintenant-fence maintenant-pg systemd"

# The bench logs in as an ordinary account: every om command, and every
# scenario command, is run through sudo on the machine it acts on.
OM="sudo -n om"

# The output flag is -o, not --format (om v3.0.0-rc30 to rc53). This is
# the only place the bench touches om's command line.
OM_DAEMON_STATUS="$OM daemon status -o json --sections daemon,nodes,arbitrators"

PG_STATE="sudo -n /usr/local/sbin/maintenant-pg-state"
# Must match drbd_resource in ansible/group_vars/all/drbd.yml.
DRBD_STATE="sudo -n drbdsetup status --json --statistics maintenant"
GIVEBACK_LAG_TRIES=10

# Must match opensvc_service_log_identifier: the tag systemd-cat gives the binary's output.
SERVER_LOG_IDENTIFIER="maintenant"
# Kept in run.json as information: the writes probe already counts an ack the server did not store.
SERVER_LOG_WATCH="insert ping"

# virsh reads qemu:///session for a non-root user, where the bench has nothing.
LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"
export LIBVIRT_DEFAULT_URI

if [ -t 1 ]; then
	C_RESET=$(printf '\033[0m')
	C_BLUE=$(printf '\033[34m')
	C_GREEN=$(printf '\033[32m')
	C_YELLOW=$(printf '\033[33m')
	C_RED=$(printf '\033[31m')
else
	C_RESET=""
	C_BLUE=""
	C_GREEN=""
	C_YELLOW=""
	C_RED=""
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
INV_JSON="$TMP/inventory.json"
RUN_SETTINGS_FILE="$TMP/run-settings.json"

die() {
	printf 'lab: %s\n' "$1" >&2
	exit "${2:-1}"
}

info() {
	printf '%s==>%s %s\n' "$C_BLUE" "$C_RESET" "$1"
}

need() {
	if ! command -v "$1" >/dev/null 2>&1; then
		die "$1 is required but not installed" 4
	fi
}

usage() {
	cat <<'USAGE'
usage: lab <command> [options]

  up [--mode <mode>]     build the topology and deploy the mode, then check it
  down                   destroy everything, leaving no residue
  host-setup             one-time host preparation (calls sudo itself):
                         image directories, fencing account and key
  status [--json]        cluster, mode, probes and OpenSVC agent of each node;
                         in sqlite/drbd, names the side of a storage split
                         brain to keep (deploy/ha/split-brain.md)
  chaos <n>              inject scenario n
  heal <n>               repair scenario n
  run-all [--mode <mode>] [--repeat <k>] [--scenario <n>]
  report [--run <id>]
  giveback               move the service back to the preferred node, refused
                         while that node's copy of the data is not up to date
  inventory              on-disk state inventory of the active node

modes: ip-only (default), postgres/streaming, sqlite/drbd, postgres/drbd
       ip-only is the bare bench: service address failover, no replicated
       backend. postgres/streaming runs a primary and a synchronous standby.
       sqlite/drbd replicates the state root with DRBD. postgres/drbd has
       no service template yet: up refuses it.

environment:
  LAB_INVENTORY   Ansible inventory to target
                  (default: ansible/inventories/lab/hosts.yml)
  LAB_SSH_KEY     private key installed on the machines and used to reach
                  them; its .pub must sit next to it
                  (default: ~/.ssh/id_ed25519)
USAGE
}

load_inventory() {
	if [ -f "$INV_JSON" ]; then
		return 0
	fi
	if [ ! -f "$INVENTORY" ]; then
		die "inventory not found: $INVENTORY" 4
	fi
	if ! ansible-inventory -i "$INVENTORY" --list >"$INV_JSON" 2>"$TMP/inv.err"; then
		die "ansible-inventory failed on $INVENTORY: $(head -n 3 "$TMP/inv.err" | tr '\n' ' ')" 4
	fi
}

group_hosts() {
	load_inventory
	jq -r --arg g "$1" '.[$g].hosts[]? // empty' "$INV_JSON"
}

hostvar() {
	load_inventory
	jq -r --arg h "$1" --arg v "$2" --arg d "$3" \
		'._meta.hostvars[$h][$v] // $d' "$INV_JSON"
}

first_cluster_host() {
	group_hosts opensvc_cluster | head -n 1
}

service_address() {
	host=$(first_cluster_host)
	if [ -z "$host" ]; then
		die "the inventory declares no opensvc_cluster host" 4
	fi
	addr=$(hostvar "$host" ha_service_address "")
	if [ -z "$addr" ]; then
		die "ha_service_address is not set in $INVENTORY" 4
	fi
	printf '%s\n' "$addr"
}

ssh_target() {
	addr=$(hostvar "$1" ansible_host "$1")
	user=$(hostvar "$1" ansible_user "")
	if [ -n "$user" ]; then
		printf '%s@%s\n' "$user" "$addr"
	else
		printf '%s\n' "$addr"
	fi
}

ssh_to() {
	host=$1
	shift
	# shellcheck disable=SC2086,SC2029 # options list; the command runs remotely on purpose
	ssh $SSH_BATCH_OPTS "$(ssh_target "$host")" "$@"
}

valid_mode() {
	for m in $KNOWN_MODES; do
		if [ "$m" = "$1" ]; then
			return 0
		fi
	done
	return 1
}

current_mode() {
	if [ -f "$STATE_DIR/mode" ]; then
		cat "$STATE_DIR/mode"
	else
		printf 'unknown\n'
	fi
}

wait_for_ssh() {
	deadline=$(($(date +%s) + SSH_WAIT_TIMEOUT))
	for host in $(all_hosts); do
		info "waiting for ssh on $host"
		while ! ssh_to "$host" true >/dev/null 2>&1; do
			if [ "$(date +%s)" -ge "$deadline" ]; then
				die "$host did not accept ssh within ${SSH_WAIT_TIMEOUT}s" 1
			fi
			sleep 5
		done
	done
}

all_hosts() {
	load_inventory
	jq -r '[.. | objects | .hosts? // empty | .[]] | unique | .[]' "$INV_JSON"
}

node_status() {
	name=$1
	address=$2
	if ! ssh_to "$name" true >/dev/null 2>&1; then
		jq -n --arg n "$name" \
			'{name: $n, reachable: false, opensvc: "unreachable", holds_address: false, postgres: null, drbd: null}'
		return 0
	fi
	if ssh_to "$name" "$OM_DAEMON_STATUS" >/dev/null 2>&1; then
		om="up"
		# Neither a frozen instance nor one stopped on purpose fails over, so a bench left so is not green.
		instances=$(ssh_to "$name" "$OM ${LAB_SERVICE_NAME:-maintenant} instance ls -o json" 2>/dev/null) || instances=""
		if printf '%s' "$instances" | jq -e --arg n "$name" 'any(.items[]; .meta.node == $n and ((.data.status.frozen_at // "0001") | startswith("0001") | not))' >/dev/null 2>&1; then
			om="frozen"
		elif printf '%s' "$instances" | jq -e --arg n "$name" 'any(.items[]; .meta.node == $n and ((.data.status.stopped_at // "0001") | startswith("0001") | not))' >/dev/null 2>&1; then
			om="stopped"
		fi
	elif ssh_to "$name" "command -v om" >/dev/null 2>&1; then
		om="down"
	else
		om="absent"
	fi
	if ssh_to "$name" "ip -o addr show" 2>/dev/null | grep -q " inet $address/"; then
		holds="true"
	else
		holds="false"
	fi
	pg="null"
	if [ "$(current_mode)" = postgres/streaming ]; then
		pg=$(ssh_to "$name" "$PG_STATE" 2>/dev/null | jq -c '.' 2>/dev/null) || pg=""
		[ -n "$pg" ] || pg='{"role": "unknown"}'
	fi
	drbd="null"
	if [ "$(current_mode)" = sqlite/drbd ]; then
		drbd=$(ssh_to "$name" "$DRBD_STATE" 2>/dev/null | jq -c '.[0] | {
			role,
			disk: .devices[0]["disk-state"],
			quorum: .devices[0].quorum,
			connections: [.connections[] | {
				peer: .name,
				state: .["connection-state"],
				peer_disk: .peer_devices[0]["peer-disk-state"],
				out_of_sync_kib: .peer_devices[0]["out-of-sync"]
			}]
		}' 2>/dev/null) || drbd=""
		[ -n "$drbd" ] || drbd='{"role": "unknown", "connections": []}'
	fi
	jq -n --arg n "$name" --arg om "$om" --argjson holds "$holds" --argjson pg "$pg" --argjson drbd "$drbd" \
		'{name: $n, reachable: true, opensvc: $om, holds_address: $holds, postgres: $pg, drbd: $drbd}'
}

unit_status() {
	host=$1
	unit=$2
	if ssh_to "$host" "systemctl is-active --quiet $unit" >/dev/null 2>&1; then
		printf 'running\n'
	elif ssh_to "$host" "systemctl cat $unit" >/dev/null 2>&1; then
		printf 'stopped\n'
	else
		printf 'absent\n'
	fi
}

reach_state() {
	if [ "$1" -eq "$2" ]; then
		printf 'up\n'
	elif [ "$1" -gt 0 ]; then
		printf 'partial\n'
	else
		printf 'unreachable\n'
	fi
}

collect_status() {
	address=$(service_address)
	nodes="[]"
	for name in $(group_hosts opensvc_cluster); do
		one=$(node_status "$name" "$address")
		nodes=$(printf '%s\n' "$nodes" | jq --argjson n "$one" '. + [$n]')
	done

	# The arbitrator is up when every node reaches the uri it votes on, the relay when every node hears its peers through it.
	arb_state="absent"
	relay_state="absent"
	if [ -n "$(group_hosts arbitrator)" ]; then
		reached=0
		relayed=0
		total=0
		for name in $(group_hosts opensvc_cluster); do
			total=$((total + 1))
			if ssh_to "$name" "$OM daemon hb list -o json" 2>/dev/null |
				jq -e --arg n "$name" '[.items[] | select(.node == $n and .type == "relay" and (.id | endswith(".rx")))] | length > 0 and all(.is_beating)' >/dev/null 2>&1; then
				relayed=$((relayed + 1))
			fi
			uri=$(ssh_to "$name" "$OM cluster config get --kw 'arbitrator#0.uri'" 2>/dev/null) || continue
			if [ -n "$uri" ] && ssh_to "$name" "curl -fsS -m 3 -o /dev/null '$uri'" >/dev/null 2>&1; then
				reached=$((reached + 1))
			fi
		done
		arb_state=$(reach_state "$reached" "$total")
		relay_state=$(reach_state "$relayed" "$total")
	fi

	probe_host=$(group_hosts measurement | head -n 1)
	if [ -z "$probe_host" ]; then
		availability="absent"
		writes="absent"
		observer="absent"
	elif ! ssh_to "$probe_host" true >/dev/null 2>&1; then
		availability="unreachable"
		writes="unreachable"
		observer="unreachable"
	else
		availability=$(unit_status "$probe_host" "$PROBE_AVAILABILITY_UNIT")
		writes=$(unit_status "$probe_host" "$PROBE_WRITES_UNIT")
		observer=$(unit_status "$probe_host" "$PROBE_OBSERVER_UNIT")
	fi

	storage=$(printf '%s\n' "$nodes" | jq -c -f "$LAB_DIR/drbd-split-brain.jq")

	jq -n \
		--arg mode "$(current_mode)" \
		--arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		--arg address "$address" \
		--arg arb "$arb_state" \
		--arg relay "$relay_state" \
		--arg availability "$availability" \
		--arg writes "$writes" \
		--arg observer "$observer" \
		--argjson nodes "$nodes" \
		--argjson storage "$storage" \
		'
		def holders: [$nodes[] | select(.holds_address)] | length;
		def postgres_nominal:
			if $mode != "postgres/streaming" then true
			else
				([$nodes[] | select(.postgres.role == "primary")] as $p
				| [$nodes[] | select(.postgres.role == "standby")] as $s
				| ($p | length) == 1 and ($s | length) == 1
				  and $p[0].holds_address
				  and $p[0].postgres.standby.state == "streaming"
				  and $p[0].postgres.standby.sync_state == "sync"
				  and $s[0].postgres.receiver == "streaming"
				  and ($s[0].postgres.fenced | not))
			end;
		def drbd_nominal:
			if $mode != "sqlite/drbd" then true
			else
				([$nodes[] | select(.drbd.role == "Primary")] as $p
				| ($p | length) == 1 and $p[0].holds_address
				  and all($nodes[]; .drbd.disk == "UpToDate" and .drbd.quorum
				      and all(.drbd.connections[]; .state == "Connected" and (.peer_disk == "UpToDate" or .peer_disk == "Diskless"))))
			end;
		{
			mode: $mode,
			generated_at: $at,
			service: {address: $address, holders: [$nodes[] | select(.holds_address) | .name]},
			nodes: $nodes,
			arbitrator: $arb,
			relay: $relay,
			probes: {availability: $availability, writes: $writes, observer: $observer},
			storage: $storage,
			verdict: (
				if holders > 1 then "split"
				elif $storage.split_brain then "split"
				elif holders == 0 then "down"
				elif $mode == "postgres/streaming" and ([$nodes[] | select(.postgres.role == "primary")] | length) > 1 then "split"
				elif ([$nodes[] | select(.reachable | not)] | length) > 0 then "degraded"
				elif ([$nodes[] | select(.opensvc != "up")] | length) > 0 then "degraded"
				elif $arb != "up" then "degraded"
				elif $relay != "up" then "degraded"
				elif $availability != "running" or $writes != "running" or $observer != "running" then "degraded"
				elif postgres_nominal | not then "degraded"
				elif drbd_nominal | not then "degraded"
				else "green"
				end
			)
		}'
}

render_status() {
	jq -r --arg reset "$C_RESET" --arg green "$C_GREEN" --arg yellow "$C_YELLOW" --arg red "$C_RED" '
		def pad(s; n): (s + "                ")[0:n];
		def colour(v):
			if v == "green" then $green
			elif v == "degraded" then $yellow
			else $red end;
		"mode       \(.mode)",
		"service    \(.service.address) on \(if (.service.holders | length) == 0 then "nobody" else (.service.holders | join(" and ")) end)",
		"arbitrator \(.arbitrator)",
		"relay      \(.relay)",
		"probes     availability=\(.probes.availability) writes=\(.probes.writes) observer=\(.probes.observer)",
		"",
		"NODE         REACHABLE  OPENSVC      ADDRESS  BACKEND",
		(.nodes[] | [pad(.name; 12), pad(if .reachable then "yes" else "no" end; 10), pad(.opensvc; 12), pad(if .holds_address then "held" else "-" end; 8),
			(if .drbd != null then "drbd \(.drbd.role) \(.drbd.disk // "-"), peers \([.drbd.connections[] | "\(.peer)=\(.state)/\(.peer_disk // "-")"] | join(" "))"
			 elif .postgres == null then "-"
			 elif .postgres.fenced then "\(.postgres.role) fenced"
			 elif .postgres.role == "primary" then "primary, standby \(.postgres.standby.state // "absent")/\(.postgres.standby.sync_state // "-") lag=\(.postgres.standby.lag_bytes // "-")"
			 elif .postgres.role == "standby" then "standby, receiver \(.postgres.receiver // "none"), synced=\(.postgres.synced)"
			 else .postgres.role end)] | join(" ")),
		(if .storage.split_brain then
			"",
			"storage    \($red)split brain\($reset): " +
			(if .storage.keep == null then "no side named (\(.storage.reason)), compare both copies"
			 else "keep \(.storage.keep) (\(.storage.reason)), discard \(.storage.discard | join(" and "))" end) +
			"; resolve by hand with deploy/ha/split-brain.md"
		 else empty end),
		"",
		"verdict    \(colour(.verdict))\(.verdict)\($reset)"
	'
}

# Each node is read against the controller's clock taken just before, so the
# time the SSH round trips take does not count as drift.
check_clocks() {
	min=""
	max=""
	for host in $(group_hosts opensvc_cluster); do
		before=$(date -u +%s)
		remote=$(ssh_to "$host" "date -u +%s") || die "cannot read the clock of $host" 1
		offset=$((remote - before))
		if [ -z "$min" ] || [ "$offset" -lt "$min" ]; then
			min=$offset
		fi
		if [ -z "$max" ] || [ "$offset" -gt "$max" ]; then
			max=$offset
		fi
	done
	[ -n "$min" ] || die "the inventory declares no opensvc_cluster host" 4
	drift=$((max - min))
	if [ "$drift" -gt "$CLOCK_DRIFT_MAX" ]; then
		die "the node clocks differ by ${drift}s, more than the ${CLOCK_DRIFT_MAX}s the bench allows" 1
	fi
}

mode_json() {
	case "$1" in
	ip-only)
		jq -n '{backend: null, replication: "ip-only"}'
		;;
	*/*)
		backend=${1%%/*}
		replication=${1#*/}
		jq -n --arg b "$backend" --arg r "$replication" '{backend: $b, replication: $r}'
		;;
	*)
		die "unknown mode: $1" 2
		;;
	esac
}

# Polls collect_status until it is green or the timeout elapses, leaving the last status in outfile either way.
wait_for_status_green() {
	timeout=$1
	interval=$2
	outfile=$3
	want_holder=${4:-}
	deadline=$(($(date +%s) + timeout))
	while :; do
		collect_status >"$outfile" 2>"$TMP/wait-status.err" || true
		if [ -s "$outfile" ] && jq -e --arg h "$want_holder" \
			'.verdict == "green" and ($h == "" or .service.holders == [$h])' "$outfile" >/dev/null 2>&1; then
			return 0
		fi
		[ "$(date +%s)" -ge "$deadline" ] && return 1
		sleep "$interval"
	done
}

probe_env_value() {
	ssh_to "$1" "sudo -n grep -m1 '^$2=' $PROBE_ENV_FILE" | cut -d= -f2-
}

run_all_versions() {
	repo_root=$(cd "$LAB_DIR" && git rev-parse --show-toplevel)
	maintenant_version=$(git -C "$repo_root" describe --tags --always --dirty 2>/dev/null) || maintenant_version=""
	lab_commit=$(git -C "$repo_root" rev-parse --short HEAD 2>/dev/null) || lab_commit=""

	node=$(first_cluster_host)
	opensvc_version=""
	kernel_version=""
	postgres_version=""
	drbd_version=""
	if [ -n "$node" ]; then
		opensvc_version=$(ssh_to "$node" "$OM --version" 2>/dev/null | head -n 1) || opensvc_version=""
		kernel_version=$(ssh_to "$node" "uname -r" 2>/dev/null) || kernel_version=""
		case "$(current_mode)" in
		postgres/*)
			postgres_version=$(ssh_to "$node" "$PG_STATE" 2>/dev/null | jq -r '.package_version // empty') || postgres_version=""
			;;
		esac
		case "$(current_mode)" in
		*/drbd)
			drbd_version=$(ssh_to "$node" "sudo -n drbdadm --version" 2>/dev/null | sed -n 's/^DRBD_KERNEL_VERSION=//p') || drbd_version=""
			;;
		esac
	fi

	edition=$(curl -fsS -m 5 "http://$(service_address):8080/api/v1/license/status" 2>/dev/null | jq -r '.edition // empty') || edition=""

	jq -n \
		--arg maintenant "$maintenant_version" \
		--arg edition "$edition" \
		--arg opensvc "$opensvc_version" \
		--arg kernel "$kernel_version" \
		--arg postgres "$postgres_version" \
		--arg drbd "$drbd_version" \
		--arg lab_commit "$lab_commit" \
		'{
			maintenant: (if $maintenant == "" then null else $maintenant end),
			edition: (if $edition == "" then null else $edition end),
			opensvc: (if $opensvc == "" then null else $opensvc end),
			drbd: (if $drbd == "" then null else $drbd end),
			postgres: (if $postgres == "" then null else $postgres end),
			kernel: (if $kernel == "" then null else $kernel end),
			lab_commit: (if $lab_commit == "" then null else $lab_commit end)
		}'
}

run_all_settings() {
	node=$(first_cluster_host)
	quorum_raw=""
	stonith_raw=""
	sqlite_sync=""
	app_restart=""
	pg_restart=""
	sync_standby=""
	slot_keep=""
	if [ -n "$node" ]; then
		quorum_raw=$(ssh_to "$node" "sudo -n om cluster status -o json" 2>/dev/null | jq -r ".cluster.config.quorum") || quorum_raw=""
		stonith_raw=$(ssh_to "$node" "sudo -n om maintenant config get --kw DEFAULT.stonith" 2>/dev/null | tr -d '[:space:]') || stonith_raw=""
		sqlite_sync=$(ssh_to "$node" "sudo -n grep -m1 '^MAINTENANT_SQLITE_SYNCHRONOUS=' /etc/maintenant.env" 2>/dev/null | cut -d= -f2-) || sqlite_sync=""
		app_restart=$(ssh_to "$node" "sudo -n om maintenant config get --kw 'app#0.restart'" 2>/dev/null | tr -d '[:space:]') || app_restart=""
		case "$(current_mode)" in
		postgres/*)
			pg_restart=$(ssh_to "$node" "sudo -n om maintenant config get --kw 'app#pg.restart'" 2>/dev/null | tr -d '[:space:]') || pg_restart=""
			sync_standby=$(ssh_to "$node" "$PG_STATE" 2>/dev/null | jq -r '.standby_missing // empty') || sync_standby=""
			slot_keep=$(ssh_to "$node" "sudo -n runuser -u postgres -- psql -X -A -t -d postgres -c 'show max_slot_wal_keep_size'" 2>/dev/null | tr -d '[:space:]') || slot_keep=""
			;;
		esac
	fi

	jq -n \
		--arg quorum "$quorum_raw" \
		--arg stonith "$stonith_raw" \
		--arg sqlite_sync "$sqlite_sync" \
		--arg app_restart "$app_restart" \
		--arg pg_restart "$pg_restart" \
		--arg sync_standby "$sync_standby" \
		--arg slot_keep "$slot_keep" \
		'
		def boolish(s): if s == "" then null elif s == "true" then true elif s == "false" then false else s end;
		def num(s): if s == "" then null else (s | tonumber? // s) end;
		def str(s): if s == "" then null else s end;
		{
			sqlite_synchronous: str($sqlite_sync),
			hb_timeout_s: null,
			ready_period_s: null,
			quorum: boolish($quorum),
			stonith: boolish($stonith),
			sync_standby: str($sync_standby),
			local_restarts: {app: num($app_restart), postgres: num($pg_restart)},
			max_slot_wal_keep_size: str($slot_keep)
		}'
}

# Records, per cluster node, the journal position the next findings start after.
server_log_cursors() {
	dir=$1
	mkdir -p "$dir"
	for host in $(group_hosts opensvc_cluster); do
		cursor=$(ssh_to "$host" "sudo -n journalctl --quiet --no-pager -n 1 -o cat --show-cursor" 2>/dev/null | sed -n 's/^-- cursor: //p') || cursor=""
		printf '%s' "$cursor" >"$dir/$host"
	done
}

# Prints one line per failed ping insert the server logged on every cluster node
# after the recorded cursor and before an epoch, and one per node whose journal cannot be read.
server_log_findings() {
	dir=$1
	until=$2
	for host in $(group_hosts opensvc_cluster); do
		cursor=$(cat "$dir/$host" 2>/dev/null) || cursor=""
		if [ -z "$cursor" ] || ! journal=$(ssh_to "$host" "sudo -n journalctl --quiet --no-pager -o short-iso --after-cursor $(shell_quote "$cursor") --until @$until" 2>/dev/null); then
			printf '%s: journal unreadable\n' "$host"
			continue
		fi
		# journalctl 252 drops the first match after the cursor when -t is also given.
		printf '%s\n' "$journal" | grep -F " ${SERVER_LOG_IDENTIFIER}[" | grep -F "$SERVER_LOG_WATCH" | grep -vF -e 'context canceled' -e 'context deadline exceeded' | sed "s/^/$host: /" || true
	done
}

# Prints one "node boot_id" line per cluster node, the id left empty when it cannot be read.
cluster_boot_ids() {
	for bi_host in $(group_hosts opensvc_cluster); do
		bi_value=$(ssh_to "$bi_host" "cat /proc/sys/kernel/random/boot_id" 2>/dev/null) || bi_value=""
		printf '%s %s\n' "$bi_host" "$bi_value"
	done
}

# Prints, comma-separated, the cluster nodes whose boot id changed between two cluster_boot_ids files or could not be read in either.
faulted_nodes() {
	for fn_host in $(group_hosts opensvc_cluster); do
		fn_before=$(awk -v h="$fn_host" '$1 == h { print $2 }' "$1")
		fn_after=$(awk -v h="$fn_host" '$1 == h { print $2 }' "$2")
		if [ -z "$fn_before" ] || [ -z "$fn_after" ] || [ "$fn_before" != "$fn_after" ]; then
			printf '%s\n' "$fn_host"
		fi
	done | paste -sd, -
}

# Prints the JSON value a probe left on stdout, or null when it printed none.
probe_json() {
	pj_out=$(printf '%s' "$1" | jq -ce 'select(type == "object")' 2>/dev/null) || pj_out=""
	printf '%s' "${pj_out:-null}"
}

# Prints the reasons, as a JSON array, the wired measures of one repetition fail it for.
measure_reasons() {
	cat >"$TMP/measure-reasons.jq" <<'JQEOF'
def declared($m): $declared | index($m) != null and ($not_applicable | index($m)) == null;
def trimmed: tostring | sub("\\s+$"; "");
def observed($m):
	if ($node_set | index($m)) != null then
		(if $node == null then {value: null, error: "the node journals were not read"}
		 else {value: $node[$m], error: ($node.errors[$m]? // "the node journals left it empty")} end)
	elif $observer == null then {value: null, error: ($observer_error // "the observer produced no result")}
	else {value: $observer[$m], error: ($observer.errors[$m]? // $observer_error // "the observer left it empty")} end;
def obj($m): if declared($m) and (($node[$m]? | type) == "object") then $node[$m] else empty end;
def num($m): if declared($m) and (($node[$m]? | type) == "number") then $node[$m] else empty end;
[
	(if ($not_applicable | index("writes")) != null then empty
	 elif $writes == null then
		(if declared("writes") then "writes: not measured (\(($writes_error // "the writes probe produced no result") | trimmed))" else empty end)
	 elif $writes.lost > 0 then
		"writes: \($writes.lost) acknowledged writes lost (seq \($writes.lost_seqs[0:10] | map(tostring) | join(", "))\(if ($writes.lost_seqs | length) > 10 then ", ..." else "" end))"
	 else empty end),
	($wired[] | select(. != "rto_ms" and . != "writes") as $m | select(declared($m))
		| observed($m) | select(.value == null) | "\($m): not measured (\(.error | trimmed))"),
	(if declared("alerts_induced") and ($observer.alerts_induced? // null) != null
		and ([$observer.alerts_induced[]] | add) > 0 then
		"alerts_induced: \([$observer.alerts_induced[]] | add) alerts raised by the failover (\($observer.alerts_induced_ids | join(", ")))"
	 else empty end),
	(if declared("agents") and ($observer.agents? // null) != null then
		$observer.agents as $a
		| (if ($a.missing | length) > 0 then "agents: \($a.missing | join(", ")) not back by the end of the window" else empty end),
		  (if ($a.new_agent_ids | length) > 0 then "agents: re-enrolled under new ids \($a.new_agent_ids | join(", "))" else empty end),
		  (if $a.max_reconnect_s > $max_reconnect then "agents: max_reconnect_s=\($a.max_reconnect_s) exceeds \($max_reconnect)s" else empty end)
	 else empty end),
	(obj("local_restarts") as $l
		| if $l.failover_expected then
			(if $l.failover then empty else "local_restarts: the service did not fail over once the restarts of \($l.resource) on \($l.node) ran out" end)
		  else
			(if $l.count == 0 then "local_restarts: \($l.resource) was not restarted on \($l.node)" else empty end),
			(if $l.count > $l.limit then "local_restarts: \($l.count) starts of \($l.resource) on \($l.node) exceed the limit of \($l.limit)" else empty end),
			(if $l.failover then "local_restarts: the service failed over instead of restarting on \($l.node)" else empty end)
		  end),
	(num("failover_count") | select(. > 0) | "failover_count: the service changed node \(.) times"),
	(obj("fencing_outcome") as $f
		| (if ($f.fenced | index($f.holder)) == null
			then "fencing_outcome: \($f.holder) was not fenced\(if ($f.failed | index($f.holder)) != null then ", its fencing failed" else "" end)"
			else empty end),
		  (if $f.started_elsewhere_before_fence then "fencing_outcome: the service started on another node before \($f.holder) was fenced" else empty end)),
	(num("agent_watchdog_restart") | select(. == 0) | "agent_watchdog_restart: systemd did not restart the cluster agent of the injected node after a watchdog timeout"),
	(obj("primary_count")
		| (if .count != 1 then "primary_count: \(.count) primaries after the repair" else empty end),
		  (if .two_primaries > 0 then "primary_count: \(.two_primaries) two_primaries events" else empty end)),
	(obj("former_primary_rebuild")
		| (if .rebuilt then empty else "former_primary_rebuild: \(.node) was not rebuilt as a standby during the repetition" end),
		  (if .primary_started_before_rebuild then "former_primary_rebuild: \(.node) ran as a primary again before it was rebuilt" else empty end)),
	(obj("loss_window") | select(.conduct == "block" and .opened)
		| "loss_window: the loss window opened (\(.reasons | join(", "))) although sync_standby is block"),
	(obj("crash_confirmed")
		| (if (.crashed | length) == 0 then "crash_confirmed: no node crashed" else empty end),
		  (if (.started_before_crash | length) > 0 then "crash_confirmed: \(.started_before_crash | join(", ")) started the service before crashing" else empty end)),
	(num("nodes_written") | select(. >= 2) | "nodes_written: \(.) nodes wrote at the same time"),
	(num("divergence") | select(. > 0) | "divergence: \(.) commits of the former primary past the fork, at least one after the promotion, thrown away by its rebuild")
]
JQEOF
	jq -nc \
		--argjson declared "$1" \
		--arg mode "$2" \
		--argjson writes "$3" \
		--argjson writes_error "$4" \
		--argjson observer "$5" \
		--argjson observer_error "$6" \
		--argjson node "$7" \
		--argjson node_set "$NODE_MEASURES" \
		--argjson wired "$(wired_measures "$2")" \
		--argjson not_applicable "$(not_applicable_measures "$2")" \
		--argjson max_reconnect "$AGENTS_RECONNECT_MAX_S" \
		-f "$TMP/measure-reasons.jq"
}

# Prints, as a JSON array, the measures that have no object in a mode.
not_applicable_measures() {
	case "$1" in
	ip-only) jq -nc --argjson s "$SHARED_DATA_MEASURES" --argjson p "$POSTGRES_MEASURES" '$s + $p' ;;
	*) printf '[]\n' ;;
	esac
}

# Prints, as a JSON array, the measures the bench takes in a mode.
wired_measures() {
	case "$1" in
	ip-only | postgres/streaming) jq -nc --argjson p "$PROBE_MEASURES" --argjson n "$NODE_MEASURES" '$p + $n' ;;
	*) printf '%s\n' "$PROBE_MEASURES" ;;
	esac
}

# Writes, as one JSON object keyed by cluster node, the lines the node scripts logged between two
# epochs, with the boot ids around the repetition and, for a node that rebooted, its boot time.
node_events() {
	ne_out=$1
	ne_since=$2
	ne_until=$3
	ne_tags=""
	for ne_tag in $NODE_EVENT_TAGS; do
		ne_tags="$ne_tags -t $ne_tag"
	done
	printf '{}' >"$ne_out"
	for ne_host in $(group_hosts opensvc_cluster); do
		ne_before=$(awk -v h="$ne_host" '$1 == h { print $2 }' "$4" | tr -d -)
		ne_after=$(awk -v h="$ne_host" '$1 == h { print $2 }' "$5" | tr -d -)
		ne_readable=true
		ssh_to "$ne_host" "sudo -n journalctl --quiet --no-pager -o json --output-fields=MESSAGE,SYSLOG_IDENTIFIER,_BOOT_ID$ne_tags --since @$ne_since --until @$ne_until" >"$TMP/node-journal.json" 2>/dev/null || ne_readable=false
		ne_btime=""
		ne_previous=false
		if [ -n "$ne_before" ] && [ -n "$ne_after" ] && [ "$ne_before" != "$ne_after" ]; then
			ne_boot=$(ssh_to "$ne_host" "awk '/^btime/ { print \$2 }' /proc/stat; sudo -n journalctl --quiet --no-pager -b $ne_before -n 1 -o cat >/dev/null 2>&1 && echo previous" 2>/dev/null) || ne_boot=""
			ne_btime=$(printf '%s\n' "$ne_boot" | sed -n 1p)
			[ "$(printf '%s\n' "$ne_boot" | sed -n 2p)" = previous ] && ne_previous=true
		fi
		if [ "$ne_readable" = true ]; then
			jq -sc 'map(select(.MESSAGE | type == "string")
				| {ts: (.__REALTIME_TIMESTAMP | tonumber), tag: .SYSLOG_IDENTIFIER, boot: ._BOOT_ID, msg: .MESSAGE})' \
				"$TMP/node-journal.json" >"$TMP/node-journal-events.json" 2>/dev/null || ne_readable=false
		fi
		[ "$ne_readable" = true ] || printf '[]' >"$TMP/node-journal-events.json"
		jq -c --arg h "$ne_host" --argjson readable "$ne_readable" --arg before "$ne_before" --arg after "$ne_after" \
			--arg btime "$ne_btime" --argjson previous "$ne_previous" --slurpfile events "$TMP/node-journal-events.json" \
			'.[$h] = {readable: $readable, boot_before: $before, boot_after: $after,
				btime_us: (($btime | tonumber?) // null | if . == null then null else . * 1000000 end), previous_boot_readable: $previous, events: $events[0]}' \
			"$ne_out" >"$ne_out.tmp" && mv "$ne_out.tmp" "$ne_out"
	done
}

# Prints the measures one repetition takes from the node journals, with an errors map, or null when the scenario declares none.
#   node_measures <declared> <mode> <holder at t0> <t0> <end> <status after repair> <local_restart> <boot ids before> <boot ids after>
node_measures() {
	nm_declared=$(jq -nc --argjson d "$1" --argjson w "$(wired_measures "$2")" --argjson n "$NODE_MEASURES" \
		'[$d[] | select(. as $m | ($w | index($m)) != null and ($n | index($m)) != null)]')
	if [ "$nm_declared" = "[]" ]; then
		printf 'null'
		return 0
	fi
	nm_mode=$2
	nm_holder=$3
	nm_events="$TMP/node-events.json"
	node_events "$nm_events" "$(($(date -u -d "$4" +%s) - 1))" "$(($(date -u -d "$5" +%s) + 1))" "$8" "$9"
	nm_t0=$(date -u -d "$4" +%s%6N)
	nm_end=$(date -u -d "$5" +%s%6N)
	nm_post=$(jq -c '.' "$6" 2>/dev/null) || nm_post=""
	[ -n "$nm_post" ] || nm_post=null
	nm_restart=$7
	nm_settings=$(cat "$RUN_SETTINGS_FILE" 2>/dev/null) || nm_settings=""
	[ -n "$nm_settings" ] || nm_settings=null

	cat >"$TMP/node-measures.jq" <<'JQEOF'
def us_s: ((. / 1000) | round) / 1000;
def iso_us: capture("^(?<s>[0-9-]+T[0-9:]+)(\\.(?<f>[0-9]+))?Z$")
	| ((.s + "Z") | fromdateiso8601) * 1000000 + (((.f // "") + "000000")[0:6] | tonumber);
def parsed: (.msg | [scan("([a-z_]+)=(\"[^\"]*\"|[^ ]+)")]
		| map({key: .[0], value: (.[1] | ltrimstr("\"") | rtrimstr("\""))}) | from_entries) as $kv
	| {node, ts, tag, boot, msg, event: $kv.event, kv: $kv};
def svc($e): .tag == "maintenant-svc" and .event == $e;
def pg($e): .tag == "maintenant-pg" and .event == $e;
def fence($e): .tag == "maintenant-fence" and .event == $e;
def takes_service: svc("started") or pg("promoting") or pg("promoted") or pg("primary_started");

$nodes_file[0] as $nodes
| ($nodes | to_entries | map(select(.value.readable | not) | .key)) as $unreadable
| ($nodes | to_entries | map(select(.value.boot_before == "" or .value.boot_after == "") | .key)) as $unbooted
| ($nodes | to_entries | map(select(.value.boot_before != "" and .value.boot_after != ""
	and .value.boot_before != .value.boot_after) | .key)) as $crashed
| ([$nodes | to_entries[] | .key as $n | .value.events[] | . + {node: $n} | parsed
	| select(.ts >= $t0 and .ts <= $end)] | sort_by(.ts)) as $ev
| (if ($unreadable | length) > 0 then "the journal of \($unreadable | join(", ")) could not be read" else null end) as $journal_error
| (if ($unbooted | length) > 0 then "the boot id of \($unbooted | join(", ")) could not be read" else null end) as $boot_error

| def local_restarts:
	if $restart == null then {error: "the scenario names no local_restart to check"}
	else ($restart.resource // "app") as $res
	| ($settings.local_restarts[$res]? // null) as $limit
	| ($restart.failover // false) as $expected
	| if ($expected | not) and $limit == null then {error: "the restart limit of \($res) could not be read from the settings"}
	  else {value: {
		resource: $res, node: $holder, limit: $limit, failover_expected: $expected,
		count: ([$ev[] | select(.node == $holder)
			| select(if $res == "postgres" then pg("primary_started") or pg("primary_start_failed")
				else svc("started") or svc("start_failed") end)] | length),
		failover: any($ev[]; .node != $holder and (svc("started") or pg("promoted")))
	  }} end
	end;

def failover_count:
	{value: (reduce ($ev[] | select(svc("started") or svc("start_failed"))) as $s ({at: $holder, n: 0};
		if $s.node != .at then {at: $s.node, n: (.n + 1)} else . end) | .n)};

def detection_delay_s:
	([$ev[] | select(.node == $holder and svc("check_dead"))] | first) as $d
	| if $d == null then {error: "no check_dead logged on \($holder) during the repetition"}
	  else {value: (($d.ts - $t0) | us_s)} end;

def fencing_outcome:
	([$ev[] | select(.node != $holder and takes_service)] | first) as $s
	| {value: {
		holder: $holder,
		fenced: ([$ev[] | select(fence("fenced")) | .kv.target] | unique),
		failed: ([$ev[] | select(fence("fence_failed")) | .kv.target] | unique),
		started_elsewhere: ($s != null),
		started_elsewhere_before_fence: ($s != null
			and ([$ev[] | select(fence("fenced") and .kv.target == $holder and .ts <= $s.ts)] | length) == 0)
	}};

def agent_watchdog_restart:
	[$ev[] | select(.node == $holder and .tag == "systemd")] as $sd
	| ([$sd[] | select(.msg | startswith("opensvc-server.service: Watchdog timeout"))] | first) as $w
	| {value: (if $w == null then 0
		else [$sd[] | select(.ts >= $w.ts and (.msg | startswith("opensvc-server.service: Scheduled restart job")))] | length end)};

def primary_count:
	if $post == null then {error: "the status after the repair could not be read"}
	else ([$post.nodes[] | select(.postgres.role? == "primary") | .name]) as $p
	| {value: {count: ($p | length), nodes: $p, two_primaries: ([$ev[] | select(pg("two_primaries"))] | length)}}
	end;

def former_primary_rebuild:
	if $post == null then {error: "the status after the repair could not be read"}
	else ([$post.nodes[] | select(.postgres.role? == "standby") | .name]) as $sb
	| if ($sb | length) != 1 then {error: "\($sb | length) standbys after the repair, expected 1"}
	  else $sb[0] as $n
	  | ($nodes[$n].boot_before // "") as $boot0
	  | if $boot0 == "" then {error: "the boot id of \($n) could not be read"}
	    else [$ev[] | select(.node == $n and .tag == "maintenant-pg")] as $ne
	    | ([$ne[] | select(.event == "rebuilt")] | last) as $done
	    | ([$ne[] | select(.event == "primary_stopped" or .event == "fenced")] | first) as $lost
	    | ([$ne[] | select(.event == "rebuild_started" and ($done == null or .ts <= $done.ts))] | first) as $began
	    | {value: {
		node: $n,
		rebuilt: ($done != null),
		method: $done.kv.method,
		duration_s: (if $done == null or $began == null then null else (($done.ts - $began.ts) | us_s) end),
		primary_started_before_rebuild: any($ne[];
			(.event == "primary_started" or .event == "primary_confirmed" or .event == "promoted")
			and ($done == null or .ts < $done.ts)
			and (.boot != $boot0 or ($lost != null and .ts > $lost.ts)))
	    }} end
	  end
	end;

def sync_standby:
	if ($settings.sync_standby? // null) == null then {error: "settings.sync_standby could not be read"}
	else {value: $settings.sync_standby} end;

def loss_window:
	([$ev[] | select(pg("sync_dropped"))]) as $open
	| ($open | first) as $o
	| (if $o == null then null else ([$ev[] | select(pg("sync_restored") and .ts >= $o.ts)] | first) end) as $c
	| {value: {
		conduct: ($settings.sync_standby? // null),
		opened: ($o != null),
		closed: ($c != null),
		duration_s: (if $c == null then null else (($c.ts - $o.ts) | us_s) end),
		reasons: ([$open[].kv.reason] | unique)
	}};

def crash_confirmed:
	if $boot_error != null then {error: $boot_error}
	elif ([$crashed[] | select($nodes[.].previous_boot_readable | not)] | length) > 0 then
		{error: "the journal of \([$crashed[] | select($nodes[.].previous_boot_readable | not)] | join(", ")) from before the crash is gone"}
	else {value: {
		crashed: $crashed,
		started_before_crash: ([$crashed[] as $n | $ev[] | select(.node == $n and .boot == $nodes[$n].boot_before and takes_service) | $n] | unique),
		confirmed: (($crashed | length) > 0
			and ([$crashed[] as $n | $ev[] | select(.node == $n and .boot == $nodes[$n].boot_before and takes_service)] | length) == 0)
	}} end;

def app_overlap:
	if $boot_error != null then {error: $boot_error}
	elif ([$crashed[] | select($nodes[.].btime_us == null)] | length) > 0 then
		{error: "the boot time of \([$crashed[] | select($nodes[.].btime_us == null)] | join(", ")) could not be read"}
	else
		([$ev[] | select(svc("started")) | {ts, node, up: true}]
		 + [$ev[] | select(svc("stopped") or svc("start_failed")) | {ts, node, up: false}]
		 + [$ev[] | select(fence("fenced")) | {ts, node: .kv.target, up: false}]
		 + [$crashed[] | {ts: $nodes[.].btime_us, node: ., up: false}])
		| sort_by(.ts)
		| {value: (reduce .[] as $e ({run: {($holder): true}, max: 1};
			.run[$e.node] = $e.up | .max = ([.max, ([.run[] | select(.)] | length)] | max)) | .max)}
	end;

def forks:
	[$ev[] | select(pg("promoted")) as $p
		| ([$ev[] | select(.node == $p.node and pg("promoting") and .ts <= $p.ts)] | last // $p) as $began
		| ($nodes | keys[] | select(. != $p.node)) as $f
		| {promoted: $p.node, at: $began.ts, former: $f,
		   report: ([$ev[] | select(.node == $f and pg("post_fork_commits") and .ts > $p.ts)] | first)}];

def after_promotion:
	forks as $forks
	| ([$forks[] | select(.report == null) | "\(.former) logged no post_fork_commits after the promotion of \(.promoted)"]
	   + [$forks[] | select(.report != null and (.report.kv.count | tonumber? // null) == null)
		| "the WAL of \(.former) past the fork could not be read"]) as $missing
	| if ($missing | length) > 0 then {error: ($missing | join("; "))}
	  else {value: ([$forks[] | (.report.kv.count | tonumber) as $count | .report.kv.last_commit as $last
		| if $count > 0 and $last != "none" and ($last | iso_us) > .at then $count else 0 end] | add // 0)}
	  end;

def nodes_written:
	if $mode == "ip-only" then app_overlap
	else after_promotion | if .value == null then . else {value: (if .value > 0 then 2 else 1 end)} end
	end;

def measure($m):
	if $mode == "ip-only" and ($postgres_set | index($m)) != null then {value: "not_applicable"}
	elif $m == "sync_standby" then sync_standby
	elif $m == "primary_count" then primary_count
	elif $journal_error != null then {error: $journal_error}
	elif $m == "local_restarts" then local_restarts
	elif $m == "failover_count" then failover_count
	elif $m == "detection_delay_s" then detection_delay_s
	elif $m == "fencing_outcome" then fencing_outcome
	elif $m == "agent_watchdog_restart" then agent_watchdog_restart
	elif $m == "former_primary_rebuild" then former_primary_rebuild
	elif $m == "loss_window" then loss_window
	elif $m == "crash_confirmed" then crash_confirmed
	elif $m == "nodes_written" then nodes_written
	elif $m == "divergence" then after_promotion
	else {error: "the bench has no rule for \($m)"} end;

[$declared[] as $m | measure($m) | {m: $m} + .] as $results
| ([$results[] | {key: .m, value: (.value // null)}] | from_entries)
  + {errors: ([$results[] | select(.error != null) | {key: .m, value: .error}] | from_entries)}
JQEOF
	jq -nc \
		--argjson declared "$nm_declared" \
		--arg mode "$nm_mode" \
		--slurpfile nodes_file "$nm_events" \
		--arg holder "$nm_holder" \
		--argjson t0 "$nm_t0" \
		--argjson end "$nm_end" \
		--argjson post "$nm_post" \
		--argjson restart "$nm_restart" \
		--argjson settings "$nm_settings" \
		--argjson postgres_set "$POSTGRES_MEASURES" \
		-f "$TMP/node-measures.jq"
}

# Aggregates one scenario's repetitions into its measures and verdict.
build_scenario_summary() {
	id=$1
	scenario_name=$2
	repetitions=$3
	runs_json=$4
	declared=$5
	summary_mode=$6

	printf '%s' "$runs_json" | jq \
		--argjson id "$id" --arg name "$scenario_name" --argjson repetitions "$repetitions" \
		--argjson declared "$declared" --arg mode "$summary_mode" --argjson wired "$(wired_measures "$summary_mode")" \
		--argjson node_set "$NODE_MEASURES" --argjson not_applicable_set "$(not_applicable_measures "$summary_mode")" '
		def med: sort as $s | ($s | length) as $n |
			if $n == 0 then null
			elif ($n % 2) == 1 then $s[($n - 1) / 2]
			else ($s[$n / 2 - 1] + $s[$n / 2]) / 2
			end;
		def sum(f): map(f) | add;
		def node($m): map(.node_measures[$m]? // empty | select(type != "string"));
		def none_if_empty(f): if length > 0 then f else null end;
		(map(select(.rto_ms != null) | .rto_ms)) as $rtos |
		(map(.writes? // empty)) as $writes |
		(map(.observer.telemetry_gap_s? // empty)) as $gaps |
		(map(.observer.telemetry_samples_lost? // empty)) as $lost |
		(map(.observer.alerts_induced? // empty)) as $alerts |
		(map(.observer.agents? // empty)) as $agents |
		[$declared[] | select(. as $m | $wired | index($m) | not)] as $not_measured |
		([$declared[] | select(. as $m | $not_applicable_set | index($m) != null)] + ($not_applicable_set - $node_set) | unique) as $not_applicable |
		{
			local_restarts: (node("local_restarts") | none_if_empty({
				repetitions: length,
				resource: .[0].resource,
				limit: .[0].limit,
				count_min: (map(.count) | min),
				count_max: (map(.count) | max),
				failovers: (map(select(.failover)) | length),
				failover_expected: .[0].failover_expected
			})),
			failover_count: (node("failover_count") | none_if_empty(max)),
			detection_delay_s: (node("detection_delay_s") | none_if_empty(max)),
			fencing_outcome: (node("fencing_outcome") | none_if_empty({
				repetitions: length,
				fenced: (map(.fenced[]) | unique),
				failed: (map(.failed[]) | unique),
				holder_fenced: (map(select(.holder as $h | .fenced | index($h) != null)) | length),
				started_elsewhere_before_fence: (map(select(.started_elsewhere_before_fence)) | length)
			})),
			agent_watchdog_restart: (node("agent_watchdog_restart") | none_if_empty(min)),
			primary_count: (node("primary_count") | none_if_empty({
				min: (map(.count) | min),
				max: (map(.count) | max),
				two_primaries: sum(.two_primaries)
			})),
			former_primary_rebuild: (node("former_primary_rebuild") | none_if_empty({
				repetitions: length,
				rebuilt: (map(select(.rebuilt)) | length),
				methods: (map(.method // empty) | unique),
				max_duration_s: (map(.duration_s // empty) | max),
				primary_started_before_rebuild: (map(select(.primary_started_before_rebuild)) | length)
			})),
			sync_standby: (map(.node_measures.sync_standby? // empty) | none_if_empty(.[0])),
			loss_window: (node("loss_window") | none_if_empty({
				repetitions: length,
				opened: (map(select(.opened)) | length),
				max_duration_s: (map(.duration_s // empty) | max)
			})),
			crash_confirmed: (node("crash_confirmed") | none_if_empty({
				repetitions: length,
				confirmed: (map(select(.confirmed)) | length),
				crashed: (map(.crashed[]) | unique),
				started_before_crash: (map(.started_before_crash[]) | unique)
			})),
			nodes_written: (node("nodes_written") | none_if_empty(max)),
			divergence: (node("divergence") | none_if_empty(add))
		} as $node_summary |
		{
			id: $id,
			name: $name,
			verdict: (if (length > 0) and (length == $repetitions) and (all(.[]; .verdict == "pass"))
				then "pass" else "fail" end),
			repetitions: length,
			measures_declared: $declared,
			not_measured: $not_measured,
			measures: ({
				rto_ms: (if ($rtos | length) > 0 then {min: ($rtos | min), p50: ($rtos | med), max: ($rtos | max)} else null end),
				writes: (if ($not_applicable_set | index("writes")) != null then "not_applicable"
					elif ($writes | length) > 0 then {
						repetitions: ($writes | length),
						ack: ($writes | sum(.ack)),
						refused: ($writes | sum(.refused)),
						unknown: ($writes | sum(.unknown)),
						lost: ($writes | sum(.lost)),
						max_lost: ($writes | map(.lost) | max),
						unrecorded: ($writes | sum(.unrecorded)),
						unknown_present: ($writes | sum(.unknown_present)),
						unknown_absent: ($writes | sum(.unknown_absent))
					} else null end),
				telemetry_gap_s: (if ($gaps | length) > 0 then ($gaps | max) else null end),
				telemetry_samples_lost: (if ($lost | length) > 0 then ($lost | max) else null end),
				alerts_induced: (if ($alerts | length) > 0 then {
					agent_offline: ([$alerts[].agent_offline] | max),
					heartbeat_overdue: ([$alerts[].heartbeat_overdue] | max),
					endpoint_down: ([$alerts[].endpoint_down] | max),
					other: ([$alerts[].other] | max)
				} else null end),
				agents: (if ($agents | length) > 0 then {
					repetitions: ($agents | length),
					expected: ($agents | map(.expected | length) | max),
					reconnected: ($agents | map(.reconnected) | min),
					missing: ($agents | sum(.missing | length)),
					missing_hosts: ($agents | map(.missing[]) | unique),
					max_reconnect_s: ($agents | map(.max_reconnect_s) | max),
					new_agent_ids: ($agents | map(.new_agent_ids[]) | unique)
				} else null end)
			} + ($node_summary | with_entries(select(.key as $k | ($declared | index($k)) != null and ($wired | index($k)) != null)))
			  + ([$not_measured[] | {key: ., value: "not_measured"}] | from_entries)
			  + ([$not_applicable[] | {key: ., value: "not_applicable"}] | from_entries)),
			runs: .
		}'
}

# A sosreport of a node, as OpenSVC support asks for, kept in the report as
# sos/<scenario>-<repetition>-<step>-<node>.tar.xz.
capture_sos() {
	cs_dir="${run_log%/*}/sos"
	mkdir -p "$cs_dir"
	cs_key=$(ssh_to "$1" "sudo -n sed -n 's/^MAINTENANT_LICENSE_KEY=//p' /etc/maintenant.env" 2>/dev/null) || cs_key=""
	# The service configuration carries the licence key: it is blanked at its own length, which keeps the tar valid.
	if ssh_to "$1" "sudo -n rm -rf /var/tmp/lab-sos && sudo -n mkdir -m 700 /var/tmp/lab-sos &&
		sudo -n timeout 600 sos report --batch --quiet --enable-plugins opensvc --all-logs --tmp-dir /var/tmp/lab-sos >/dev/null &&
		sudo -n sh -c 'cat /var/tmp/lab-sos/sosreport-*.tar.xz'" 2>>"$run_log" | xz -dc |
		CS_KEY="$cs_key" python3 -c 'import os, sys; k = os.environ["CS_KEY"].encode(); d = sys.stdin.buffer.read(); sys.stdout.buffer.write(d.replace(k, b"X" * len(k)) if k else d)' |
		xz -c >"$cs_dir/$2-$1.tar.xz" && [ "$(xz -dc "$cs_dir/$2-$1.tar.xz" | head -c 1 | wc -c)" -eq 1 ]; then
		:
	else
		rm -f "$cs_dir/$2-$1.tar.xz"
		printf '%s sosreport of %s failed\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$1" >>"$run_log"
	fi
	ssh_to "$1" "sudo -n rm -rf /var/tmp/lab-sos" 2>/dev/null || true
}

# om3's own view of the cluster and of the service on every node, kept in the
# report as om/<scenario>-<repetition>-<step>-<node>.txt, and a sosreport of
# every node that answers. The others are listed in $TMP/sos-missing-<step>.
capture_om() {
	co_dir="${run_log%/*}/om"
	mkdir -p "$co_dir"
	co_pids=""
	: >"$TMP/sos-missing-$1"
	for co_host in $(group_hosts opensvc_cluster); do
		{
			date -u +%Y-%m-%dT%H:%M:%S.%NZ
			ssh_to "$co_host" "timeout 20 $OM mon --color no; echo; timeout 20 $OM ${LAB_SERVICE_NAME:-maintenant} status --color no" 2>&1 ||
				echo "capture rc=$?"
		} >"$co_dir/$1-$co_host.txt"
		if ssh_to "$co_host" true 2>/dev/null; then
			capture_sos "$co_host" "$1" &
			co_pids="$co_pids $!"
		else
			printf '%s\n' "$co_host" >>"$TMP/sos-missing-$1"
		fi
	done
	# shellcheck disable=SC2086 # one pid per word
	[ -z "$co_pids" ] || wait $co_pids
}

# Plays one scenario, every repetition, for the mode under test.
run_all_scenario() {
	number=$1
	file=$2
	mode=$3
	repeat_override=$4
	run_log=$5
	scenarios_ndjson=$6
	padded=$(printf '%02d' "$number")

	scenario_json "$file" >"$TMP/scenario-def-$number.json"
	id=$(jq -r '.id' "$TMP/scenario-def-$number.json")
	slug=$(jq -r '.slug' "$TMP/scenario-def-$number.json")
	# Not "name": scenario_act and collect_status both clobber that global.
	scenario_name=$(jq -r '.name' "$TMP/scenario-def-$number.json")

	mode_entry=$(jq -c --arg m "$mode" '.modes[$m] // empty' "$TMP/scenario-def-$number.json")
	declared=$(jq -c '.measures // []' "$TMP/scenario-def-$number.json")

	if [ -z "$mode_entry" ]; then
		printf '%s %-30s fail (no expectation for mode %s)\n' "$padded" "$slug" "$mode"
		scenario=$(jq -nc --argjson id "$id" --arg name "$scenario_name" --arg mode "$mode" \
			'{id: $id, name: $name, verdict: "fail", reason: ("no expectation for mode " + $mode), repetitions: 0, measures: null, runs: []}')
		printf '%s\n' "$scenario" >>"$scenarios_ndjson"
		return 0
	fi

	applicable=$(printf '%s' "$mode_entry" | jq -r '.applicable')
	if [ "$applicable" != "true" ]; then
		reason=$(printf '%s' "$mode_entry" | jq -r '.reason // "no reason given"')
		printf '%s %-30s not_applicable (%s)\n' "$padded" "$slug" "$reason"
		scenario=$(jq -nc --argjson id "$id" --arg name "$scenario_name" --arg reason "$reason" \
			'{id: $id, name: $name, verdict: "not_applicable", reason: $reason, repetitions: 0, measures: null, runs: []}')
		printf '%s\n' "$scenario" >>"$scenarios_ndjson"
		return 0
	fi

	repetitions=$(jq -r '.repetitions' "$TMP/scenario-def-$number.json")
	if [ -n "$repeat_override" ]; then
		repetitions=$repeat_override
	fi
	max_rto_s=$(printf '%s' "$mode_entry" | jq -r '.max_rto_s // empty')
	settle_s=$(jq -r '.settle_s // 0' "$TMP/scenario-def-$number.json")
	start_holder=""
	case "$(jq -r '.start_on // empty' "$TMP/scenario-def-$number.json")" in
	'') ;;
	preferred) start_holder=$(preferred_node) ;;
	*)
		printf '%s %-30s fail (start_on only accepts preferred)\n' "$padded" "$slug"
		scenario=$(jq -nc --argjson id "$id" --arg name "$scenario_name" \
			'{id: $id, name: $name, verdict: "fail", reason: "start_on only accepts preferred", repetitions: 0, measures: null, runs: []}')
		printf '%s\n' "$scenario" >>"$scenarios_ndjson"
		return 0
		;;
	esac

	reps_ndjson="$TMP/reps-$number.ndjson"
	: >"$reps_ndjson"

	rep=1
	while [ "$rep" -le "$repetitions" ]; do
		if ! wait_for_status_green "$RUN_ALL_GREEN_TIMEOUT" "$RUN_ALL_GREEN_INTERVAL" "$TMP/status-pre-$number.json"; then
			pre_verdict=$(jq -r '.verdict // "unknown"' "$TMP/status-pre-$number.json" 2>/dev/null)
			printf '%s %-30s rep %s/%s fail (bench not green before start: %s)\n' "$padded" "$slug" "$rep" "$repetitions" "$pre_verdict"
			one=$(jq -nc --argjson rep "$rep" --arg reason "bench not green before repetition ($pre_verdict)" \
				'{repetition: $rep, verdict: "fail", reasons: [$reason]}')
			printf '%s\n' "$one" >>"$reps_ndjson"
			RUN_ALL_ABORTED=1
			break
		fi

		if [ -n "$start_holder" ] && ! jq -e --arg h "$start_holder" '.service.holders == [$h]' "$TMP/status-pre-$number.json" >/dev/null; then
			printf '%s giveback to %s before scenario %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$start_holder" "$number" >>"$run_log"
			# A subshell, because cmd_giveback dies on refusal and clobbers globals.
			if ! (cmd_giveback) >>"$run_log" 2>&1; then
				printf '%s %-30s rep %s/%s fail (the service could not be given back to %s)\n' "$padded" "$slug" "$rep" "$repetitions" "$start_holder"
				one=$(jq -nc --argjson rep "$rep" --arg reason "the service could not be given back to $start_holder before the repetition" \
					'{repetition: $rep, verdict: "fail", reasons: [$reason]}')
				printf '%s\n' "$one" >>"$reps_ndjson"
				break
			fi
		fi

		holder_t0=$start_holder
		[ -n "$holder_t0" ] || holder_t0=$(jq -r '.service.holders[0] // empty' "$TMP/status-pre-$number.json")

		server_log_cursors "$TMP/server-log-cursors-$number-$rep"
		cluster_boot_ids >"$TMP/boot-before-$number-$rep"
		t0=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)

		if inj_out=$(scenario_act injection "$number" 2>&1); then
			injection_rc=0
		else
			injection_rc=$?
		fi
		printf '%s\n' "$inj_out" >>"$run_log"
		sleep "$settle_s"

		verify_ok=0
		deadline=$(($(date +%s) + RUN_ALL_VERIFY_TIMEOUT))
		while :; do
			if ver_out=$(scenario_act verify "$number" 2>&1); then
				verify_ok=1
				printf '%s\n' "$ver_out" >>"$run_log"
				break
			fi
			printf '%s\n' "$ver_out" >>"$run_log"
			[ "$(date +%s)" -ge "$deadline" ] && break
			sleep "$RUN_ALL_VERIFY_INTERVAL"
		done
		t1=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
		[ "$verify_ok" -eq 1 ] || capture_om "$padded-$rep-verify"

		if heal_out=$(scenario_act repair "$number" 2>&1); then
			repair_rc=0
			deadline=$(($(date +%s) + RUN_ALL_VERIFY_TIMEOUT))
			while :; do
				if ver_out=$(scenario_act verify "$number" 2>&1); then
					break
				fi
				if [ "$(date +%s)" -ge "$deadline" ]; then
					capture_om "$padded-$rep-repair"
					repair_rc=1
					heal_out="$heal_out
$ver_out"
					break
				fi
				sleep "$RUN_ALL_VERIFY_INTERVAL"
			done
		else
			repair_rc=$?
		fi
		printf '%s\n' "$heal_out" >>"$run_log"
		if [ -s "$TMP/sos-missing-$padded-$rep-verify" ]; then
			while read -r co_host; do
				capture_sos "$co_host" "$padded-$rep-repaired"
			done <"$TMP/sos-missing-$padded-$rep-verify"
		fi
		rm -f "$(injection_record "$number")"

		green_after=1
		wait_for_status_green "$RUN_ALL_GREEN_TIMEOUT" "$RUN_ALL_GREEN_INTERVAL" "$TMP/status-post-$number.json" || green_after=0
		holders=$(jq -r '.service.holders | length' "$TMP/status-post-$number.json" 2>/dev/null)
		case "$holders" in '' | *[!0-9]*) holders=-1 ;; esac
		cluster_boot_ids >"$TMP/boot-after-$number-$rep"
		faulted=$(faulted_nodes "$TMP/boot-before-$number-$rep" "$TMP/boot-after-$number-$rep")
		t_end=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)

		t1_window=$(date -u -d "$t1 +10 seconds" +%Y-%m-%dT%H:%M:%S.%NZ)
		agents_to=$(date -u -d "$t1 +$AGENTS_RECONNECT_MAX_S seconds" +%Y-%m-%dT%H:%M:%S.%NZ)
		agents_wait=$(($(date -u -d "$agents_to" +%s) + 2 - $(date +%s)))
		[ "$agents_wait" -le 0 ] || sleep "$agents_wait"

		availability_json=null
		availability_error=null
		observer_json=null
		observer_error=null
		writes_json=null
		writes_error=null

		probe_host=$(group_hosts measurement | head -n 1)
		if [ -z "$probe_host" ]; then
			availability_error='"the inventory declares no measurement host"'
			observer_error='"the inventory declares no measurement host"'
			writes_error='"the inventory declares no measurement host"'
		else
			state_dir=$(probe_env_value "$probe_host" PROBE_STATE_DIR) || state_dir=""
			base_url=$(probe_env_value "$probe_host" PROBE_BASE_URL) || base_url=""
			if [ -z "$state_dir" ]; then
				availability_error='"PROBE_STATE_DIR could not be read on the measurement host"'
				observer_error='"PROBE_STATE_DIR could not be read on the measurement host"'
				writes_error='"PROBE_STATE_DIR could not be read on the measurement host"'
			else
				avail_journal="$state_dir/availability.ndjson"
				observer_journal="$state_dir/observer.ndjson"

				avail_cmd="sudo -n $PROBE_BIN_DIR/lab-probe-availability -mode summarise -out $(shell_quote "$avail_journal") -from $(shell_quote "$t0") -to $(shell_quote "$t1_window")"
				if avail_out=$(ssh_to "$probe_host" "$avail_cmd" 2>"$TMP/avail-$number.err"); then
					availability_json=$avail_out
				else
					availability_error=$(jq -Rs '.' "$TMP/avail-$number.err")
				fi

				witness=$(probe_env_value "$probe_host" PROBE_WITNESS_CONTAINER) || witness=""
				if [ -z "$base_url" ]; then
					observer_error='"PROBE_BASE_URL could not be read on the measurement host"'
				elif [ -z "$witness" ]; then
					observer_error='"PROBE_WITNESS_CONTAINER could not be read on the measurement host"'
				else
					obs_cmd="sudo -n $PROBE_BIN_DIR/lab-probe-observer -mode summarise -journal $(shell_quote "$observer_journal") -from $(shell_quote "$t0") -to $(shell_quote "$t1_window") -agents-to $(shell_quote "$agents_to") -base $(shell_quote "$base_url") -container-name $(shell_quote "$witness") -container-host $(shell_quote "$probe_host") -faulted-hosts $(shell_quote "$faulted")"
					obs_out=$(ssh_to "$probe_host" "$obs_cmd" 2>"$TMP/obs-$number.err") || true
					observer_json=$(probe_json "$obs_out")
					if [ -s "$TMP/obs-$number.err" ]; then
						observer_error=$(jq -Rs '.' "$TMP/obs-$number.err")
					elif [ "$observer_json" = null ]; then
						observer_error='"the observer printed no result"'
					fi
				fi

				heartbeat=$(probe_env_value "$probe_host" PROBE_HEARTBEAT) || heartbeat=""
				if [ "$mode" = ip-only ]; then
					:
				elif [ -z "$base_url" ] || [ -z "$heartbeat" ]; then
					writes_error='"PROBE_BASE_URL or PROBE_HEARTBEAT could not be read on the measurement host"'
				else
					writes_cmd="sudo -n $PROBE_BIN_DIR/lab-probe-writes -mode verify -timeout $WRITES_VERIFY_TIMEOUT -base $(shell_quote "$base_url") -heartbeat $(shell_quote "$heartbeat") -journal $(shell_quote "$state_dir/writes.ndjson") -from $(shell_quote "$t0") -to $(shell_quote "$t1_window")"
					writes_out=$(ssh_to "$probe_host" "$writes_cmd" 2>"$TMP/writes-$number.err") || true
					writes_json=$(probe_json "$writes_out")
					if [ "$writes_json" = null ]; then
						if [ -s "$TMP/writes-$number.err" ]; then
							writes_error=$(jq -Rs '.' "$TMP/writes-$number.err")
						else
							writes_error='"the writes probe printed no result"'
						fi
					fi
				fi
			fi
		fi

		rto_ms=$(printf '%s' "$availability_json" | jq -r 'if . == null then "" else (.rto_ms | tostring) end' 2>/dev/null)

		log_until=$(date -u -d "$t1_window" +%s)
		server_log_findings "$TMP/server-log-cursors-$number-$rep" "$log_until" >"$TMP/server-log-$number-$rep.txt"
		server_log_json=$(jq -Rsc 'split("\n") | map(select(length > 0))' "$TMP/server-log-$number-$rep.txt")

		node_measures_json=$(node_measures "$declared" "$mode" "$holder_t0" "$t0" "$t_end" \
			"$TMP/status-post-$number.json" "$(jq -c '.local_restart // null' "$TMP/scenario-def-$number.json")" \
			"$TMP/boot-before-$number-$rep" "$TMP/boot-after-$number-$rep") || node_measures_json=""
		[ -n "$node_measures_json" ] || node_measures_json=null

		reasons_file="$TMP/reasons-$number-$rep.json"
		printf '[]' >"$reasons_file"
		add_reason() {
			printf '%s' "$(jq --arg r "$1" '. + [$r]' "$reasons_file")" >"$reasons_file"
		}

		[ "$injection_rc" -eq 0 ] || add_reason "injection failed (rc=$injection_rc)"
		[ "$verify_ok" -eq 1 ] || add_reason "verify did not succeed within ${RUN_ALL_VERIFY_TIMEOUT}s"
		[ "$repair_rc" -eq 0 ] || add_reason "repair failed (rc=$repair_rc)"
		[ "$green_after" -eq 1 ] || add_reason "bench did not return to green after repair"
		[ "$holders" -eq 1 ] || add_reason "holders after recovery = $holders, expected 1"
		if measure_reasons "$declared" "$mode" "$writes_json" "$writes_error" "$observer_json" "$observer_error" "$node_measures_json" >"$TMP/measure-reasons-$number-$rep.json" &&
			jq -r '.[]' "$TMP/measure-reasons-$number-$rep.json" >"$TMP/measure-reasons-$number-$rep.txt"; then
			while IFS= read -r measure_reason; do
				add_reason "$measure_reason"
			done <"$TMP/measure-reasons-$number-$rep.txt"
		else
			add_reason "the measures could not be judged"
		fi
		if [ -n "$max_rto_s" ]; then
			if [ -z "$rto_ms" ]; then
				add_reason "max_rto_s is set but the availability rto_ms is unavailable"
			else
				max_rto_ms=$((max_rto_s * 1000))
				if [ "$rto_ms" -gt "$max_rto_ms" ]; then
					add_reason "rto_ms=$rto_ms exceeds max_rto_s=${max_rto_s}s"
				fi
			fi
		fi

		if [ "$(jq 'length' "$reasons_file")" -eq 0 ]; then
			rep_verdict=pass
		else
			rep_verdict=fail
		fi

		if [ -n "$rto_ms" ]; then
			rto_display="rto=$(awk -v ms="$rto_ms" 'BEGIN { printf "%.1f", ms / 1000 }')s"
		else
			rto_display="rto=n/a"
		fi
		printf '%s %-30s rep %s/%s %s %s\n' "$padded" "$slug" "$rep" "$repetitions" "$rep_verdict" "$rto_display"
		jq -r '.[] | "    - " + .' "$reasons_file"

		one=$(jq -nc \
			--argjson rep "$rep" --arg t0 "$t0" --arg t1 "$t1" --arg t_end "$t_end" --arg holder_t0 "$holder_t0" \
			--argjson injection_rc "$injection_rc" \
			--argjson verify_ok "$([ "$verify_ok" -eq 1 ] && echo true || echo false)" \
			--argjson repair_rc "$repair_rc" \
			--argjson holders "$holders" \
			--arg rto_ms_raw "$rto_ms" \
			--argjson availability "$availability_json" \
			--argjson availability_error "$availability_error" \
			--argjson observer "$observer_json" \
			--argjson observer_error "$observer_error" \
			--argjson writes "$writes_json" \
			--argjson writes_error "$writes_error" \
			--arg faulted "$faulted" \
			--argjson server_log "$server_log_json" \
			--argjson node_measures "$node_measures_json" \
			--argjson reasons "$(cat "$reasons_file")" \
			--arg verdict "$rep_verdict" \
			'{
				repetition: $rep, t0: $t0, t1: $t1, t_end: $t_end,
				holder_t0: (if $holder_t0 == "" then null else $holder_t0 end),
				injection_rc: $injection_rc, verify_ok: $verify_ok, repair_rc: $repair_rc,
				holders: $holders,
				rto_ms: (if $rto_ms_raw == "" then null else ($rto_ms_raw | tonumber) end),
				availability: $availability, availability_error: $availability_error,
				observer: $observer, observer_error: $observer_error,
				writes: $writes, writes_error: $writes_error,
				node_measures: $node_measures,
				faulted_hosts: ($faulted | split(",") | map(select(length > 0))),
				server_log: $server_log,
				verdict: $verdict, reasons: $reasons
			}')
		printf '%s\n' "$one" >>"$reps_ndjson"

		rep=$((rep + 1))
	done

	runs_json=$(jq -s '.' "$reps_ndjson")
	scenario=$(build_scenario_summary "$id" "$scenario_name" "$repetitions" "$runs_json" "$declared" "$mode")
	printf '%s\n' "$scenario" >>"$scenarios_ndjson"
}

cmd_run_all() {
	mode=""
	repeat=""
	only=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--mode)
			[ $# -ge 2 ] || die "--mode takes a value" 2
			mode=$2
			shift 2
			;;
		--repeat)
			[ $# -ge 2 ] || die "--repeat takes a value" 2
			repeat=$2
			shift 2
			;;
		--scenario)
			[ $# -ge 2 ] || die "--scenario takes a value" 2
			only=$2
			shift 2
			;;
		*) die "unknown option for run-all: $1" 2 ;;
		esac
	done

	need ansible-inventory
	need jq
	need ssh
	need python3
	need git
	need curl

	deployed=$(current_mode)
	[ "$deployed" != "unknown" ] || die "no mode is deployed: run 'lab up' first" 2
	if [ -z "$mode" ]; then
		mode=$deployed
	fi
	valid_mode "$mode" || die "unknown mode: $mode (known: $KNOWN_MODES)" 2
	[ "$mode" = "$deployed" ] || die "mode $mode is not the deployed mode ($deployed): run-all never redeploys" 2

	if [ -n "$repeat" ]; then
		case "$repeat" in
		'' | *[!0-9]*) die "--repeat must be a positive integer: $repeat" 2 ;;
		esac
		[ "$repeat" -gt 0 ] || die "--repeat must be a positive integer: $repeat" 2
	fi
	if [ -n "$only" ]; then
		case "$only" in
		'' | *[!0-9]*) die "--scenario must be a scenario number: $only" 2 ;;
		esac
		only=$(printf '%02d' "$only")
		set -- "$LAB_DIR"/scenarios/"$only"-*.yml
		[ -f "$1" ] || die "no scenario $only in $LAB_DIR/scenarios" 2
	fi

	info "checking the node clocks"
	check_clocks

	collect_status >"$TMP/status-initial.json"
	verdict=$(jq -r '.verdict' "$TMP/status-initial.json")
	[ "$verdict" = "green" ] || die "the bench is not green (verdict: $verdict): run-all refuses to start" 1

	run_id="$(date -u +%Y%m%d-%H%M%S)-$(printf '%s' "$mode" | tr '/' '-')"
	report_dir="$HA_DIR/reports/$run_id"
	mkdir -p "$report_dir"
	run_log="$report_dir/run.log"
	: >"$run_log"
	printf 'lab run-all %s mode=%s\n' "$run_id" "$mode" >>"$run_log"

	info "run-all $run_id starting, mode=$mode"

	run_all_settings >"$RUN_SETTINGS_FILE"

	scenarios_ndjson="$report_dir/scenarios.ndjson"
	: >"$scenarios_ndjson"

	for file in "$LAB_DIR"/scenarios/[0-9][0-9]-*.yml; do
		[ -f "$file" ] || continue
		[ -z "$only" ] || [ "$(basename "$file" | cut -c1-2)" = "$only" ] || continue
		# Plain decimal, not zero-padded: dash's printf %d misreads "08"/"09" as
		# invalid octal, and scenario_act re-pads on its own.
		number=$(basename "$file" | cut -c1-2)
		number=${number#0}
		run_all_scenario "$number" "$file" "$mode" "$repeat" "$run_log" "$scenarios_ndjson"
		if [ "$RUN_ALL_ABORTED" -eq 1 ]; then
			info "run-all stopped after scenario $number: the bench did not return to green"
			break
		fi
	done

	versions_json=$(run_all_versions)
	settings_json=$(cat "$RUN_SETTINGS_FILE")
	mode_json_val=$(mode_json "$mode")

	run_json=$(jq -n \
		--arg run_id "$run_id" \
		--argjson mode "$mode_json_val" \
		--argjson versions "$versions_json" \
		--argjson settings "$settings_json" \
		--slurpfile scenarios "$scenarios_ndjson" \
		'{
			run_id: $run_id,
			mode: $mode,
			versions: $versions,
			settings: $settings,
			scenarios: $scenarios,
			totals: {
				scenarios: ($scenarios | length),
				pass: ([$scenarios[] | select(.verdict == "pass")] | length),
				fail: ([$scenarios[] | select(.verdict == "fail")] | length),
				not_applicable: ([$scenarios[] | select(.verdict == "not_applicable")] | length)
			}
		}')

	printf '%s\n' "$run_json" >"$report_dir/run.json"
	render_report "$report_dir/run.json" >"$report_dir/run.md"

	pass=$(printf '%s' "$run_json" | jq -r '.totals.pass')
	fail=$(printf '%s' "$run_json" | jq -r '.totals.fail')
	na=$(printf '%s' "$run_json" | jq -r '.totals.not_applicable')
	info "run-all $run_id complete: $pass pass, $fail fail, $na not applicable"
	info "report: $report_dir/run.md"

	[ "$fail" -eq 0 ] || exit 1
}

scenario_file() {
	n=$(printf '%02d' "$1" 2>/dev/null) || die "scenario must be a number: $1" 2
	for match in "$LAB_DIR/scenarios/$n-"*.yml; do
		if [ -f "$match" ]; then
			printf '%s\n' "$match"
			return 0
		fi
	done
	die "no scenario $1 in $LAB_DIR/scenarios" 2
}

scenario_json() {
	python3 -c 'import json,sys,yaml; json.dump(yaml.safe_load(open(sys.argv[1])), sys.stdout)' "$1" ||
		die "cannot read $1: is PyYAML installed?" 4
}

# Every scenario command is run through sh with the bench exported around it,
# so a scenario file names what it acts on and never where that thing is.
#
# A repair undoes what the injection did, to the node the injection hit: the
# pair is recorded when the failure is injected and read back afterwards, since
# the failover has moved the service in between.
scenario_env() {
	number=$1
	action=$2
	address=$(service_address)
	load_inventory
	record="$STATE_DIR/injection-$(printf '%02d' "$number")"

	active=""
	passive=""
	if [ "$action" != "injection" ] && [ -f "$record" ]; then
		active=$(sed -n 1p "$record")
		passive=$(sed -n 2p "$record")
	else
		for name in $(group_hosts opensvc_cluster); do
			if ssh_to "$name" "ip -o addr show" 2>/dev/null | grep -q " inet $address/"; then
				active="$name"
			else
				passive="$name"
			fi
		done
		if [ -z "$active" ]; then
			die "no node holds $address: nothing to inject into" 1
		fi
		if [ "$action" = "injection" ]; then
			mkdir -p "$STATE_DIR"
			printf '%s\n%s\n' "$active" "$passive" >"$record"
		fi
	fi

	arbitrator=$(group_hosts arbitrator | head -n 1)
	probe=$(group_hosts measurement | head -n 1)

	LAB_MODE=$(current_mode)
	LAB_SERVICE="${LAB_SERVICE_NAME:-maintenant}"
	LAB_SERVICE_ADDRESS="$address"
	LAB_SERVICE_NETMASK="${LAB_SERVICE_NETMASK:-24}"
	LAB_ACTIVE="$active"
	LAB_PASSIVE="$passive"
	LAB_ACTIVE_ADDRESS=$(hostvar "$active" ansible_host "$active")
	LAB_PASSIVE_ADDRESS=$(hostvar "$passive" ansible_host "$passive")
	LAB_ARBITRATOR_ADDRESS=$(hostvar "$arbitrator" ansible_host "$arbitrator")
	LAB_MEASUREMENT_ADDRESS=$(hostvar "$probe" ansible_host "$probe")
	LAB_ACTIVE_DOMAIN="$LAB_DOMAIN_PREFIX$active"
	LAB_PASSIVE_DOMAIN="$LAB_DOMAIN_PREFIX$passive"
	LAB_STATE_DIR="${LAB_STATE_DIR:-/var/lib/maintenant}"
	LAB_INTERCONNECT=$(ssh_to "$active" "ip -o -4 addr show" 2>/dev/null |
		awk -v a="$LAB_ACTIVE_ADDRESS/" '$0 ~ " inet "a {print $2; exit}')
	LAB_SSH_ACTIVE="ssh $SSH_BATCH_OPTS $(ssh_target "$active")"
	LAB_SSH_PASSIVE="ssh $SSH_BATCH_OPTS $(ssh_target "$passive")"
	LAB_SSH_ARBITRATOR="ssh $SSH_BATCH_OPTS $(ssh_target "$arbitrator")"
	LAB_CLI="$LAB_DIR/lab"
	LAB_RUN_DIR="$STATE_DIR"
	mkdir -p "$LAB_RUN_DIR"

	export LAB_MODE LAB_SERVICE LAB_SERVICE_ADDRESS LAB_SERVICE_NETMASK \
		LAB_ACTIVE LAB_PASSIVE LAB_ACTIVE_ADDRESS LAB_PASSIVE_ADDRESS \
		LAB_ARBITRATOR_ADDRESS LAB_MEASUREMENT_ADDRESS \
		LAB_ACTIVE_DOMAIN LAB_PASSIVE_DOMAIN LAB_STATE_DIR LAB_INTERCONNECT \
		LAB_SSH_ACTIVE LAB_SSH_PASSIVE LAB_SSH_ARBITRATOR LAB_CLI LAB_RUN_DIR
}

shell_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# A scenario names what it acts on with the LAB_ variables, which live on the
# controller: they are carried over and the command is run as root there.
scenario_remote() {
	prelude=""
	for name in LAB_MODE LAB_SERVICE LAB_SERVICE_ADDRESS LAB_SERVICE_NETMASK \
		LAB_ACTIVE LAB_PASSIVE LAB_ACTIVE_ADDRESS LAB_PASSIVE_ADDRESS \
		LAB_ARBITRATOR_ADDRESS LAB_MEASUREMENT_ADDRESS \
		LAB_ACTIVE_DOMAIN LAB_PASSIVE_DOMAIN LAB_STATE_DIR LAB_INTERCONNECT; do
		value=""
		eval "value=\${$name-}"
		prelude="$prelude$name=$(shell_quote "$value"); export $name; "
	done
	ssh_to "$1" "sudo -n sh -c $(shell_quote "$prelude$2")"
}

scenario_run() {
	where=$1
	command=$2
	case "$where" in
	host) sh -c "$command" ;;
	active) scenario_remote "$LAB_ACTIVE" "$command" ;;
	passive) scenario_remote "$LAB_PASSIVE" "$command" ;;
	arbitrator) scenario_remote "$(group_hosts arbitrator | head -n 1)" "$command" ;;
	measurement) scenario_remote "$(group_hosts measurement | head -n 1)" "$command" ;;
	*) die "scenario targets an unknown place: $where" 2 ;;
	esac
}

scenario_act() {
	action=$1
	number=$2

	need ansible-inventory
	need jq
	need ssh
	need python3

	file=$(scenario_file "$number")
	scenario_env "$number" "$action"
	scenario_json "$file" >"$TMP/scenario.json"

	name=$(jq -r '.name' "$TMP/scenario.json")
	applicable=$(jq -r --arg m "$LAB_MODE" '.modes[$m] | if . == null then "unset" else (.applicable | tostring) end' "$TMP/scenario.json")

	if [ "$applicable" = "unset" ]; then
		die "scenario $number says nothing about mode $LAB_MODE" 2
	fi
	if [ "$applicable" != "true" ]; then
		reason=$(jq -r --arg m "$LAB_MODE" '.modes[$m].reason // "no reason given"' "$TMP/scenario.json")
		die "scenario $number ($name) has no object in mode $LAB_MODE: $reason" 3
	fi

	where=$(jq -r --arg a "$action" '.[$a].on' "$TMP/scenario.json")
	command=$(jq -r --arg a "$action" '.[$a].command' "$TMP/scenario.json")

	stamp=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
	printf '%s %s scenario %s (%s) on %s, active=%s passive=%s\n' \
		"$stamp" "$action" "$number" "$name" "$where" "$LAB_ACTIVE" "$LAB_PASSIVE"

	if scenario_run "$where" "$command"; then
		rc=0
	else
		rc=$?
	fi

	printf '%s %s done rc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$action" "$rc"
	return "$rc"
}

injection_record() {
	printf '%s/injection-%02d\n' "$STATE_DIR" "$1"
}

cmd_chaos() {
	[ $# -eq 1 ] || die "usage: lab chaos <n>" 2
	scenario_act injection "$1"
}

cmd_heal() {
	[ $# -eq 1 ] || die "usage: lab heal <n>" 2
	scenario_act repair "$1"
	info "checking the bench came back"
	scenario_act verify "$1"
	rm -f "$(injection_record "$1")"
}

cmd_host_setup() {
	[ "$(id -u)" -ne 0 ] || die "run host-setup as your own user, not under sudo: it calls sudo itself" 2
	need ansible-playbook
	need ssh-keygen
	need sudo

	key_dir="$HOME/.local/share/maintenant-lab"
	mkdir -p "$key_dir"
	chmod 0700 "$key_dir"
	if [ ! -f "$key_dir/fencing_ed25519" ]; then
		ssh-keygen -q -t ed25519 -N "" -C maintenant-fencing -f "$key_dir/fencing_ed25519"
	fi

	info "preparing the host (sudo password required)"
	ansible_playbook=$(command -v ansible-playbook)
	sudo env \
		ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
		ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_COLLECTIONS_PATH:-$HOME/.ansible/collections:/usr/share/ansible/collections}" \
		"$ansible_playbook" -i "$INVENTORY" "$LAB_DIR/host-setup.yml" \
		-e "lab_operator=$(id -un)" -e "fencing_key_dir=$key_dir"
	info "host ready"
}

cmd_up() {
	mode="$DEFAULT_MODE"
	while [ $# -gt 0 ]; do
		case "$1" in
		--mode)
			[ $# -ge 2 ] || die "--mode takes a value" 2
			mode=$2
			shift 2
			;;
		*) die "unknown option for up: $1" 2 ;;
		esac
	done
	valid_mode "$mode" || die "unknown mode: $mode (known: $KNOWN_MODES)" 2
	if [ ! -f "$LAB_SSH_KEY" ] || [ ! -f "$LAB_SSH_KEY.pub" ]; then
		die "ssh key not found: $LAB_SSH_KEY and $LAB_SSH_KEY.pub (set LAB_SSH_KEY)" 4
	fi
	template="$HA_DIR/opensvc/maintenant-$(printf '%s' "$mode" | tr '/' '-').conf"
	[ -f "$template" ] || die "mode $mode has no service template yet: $template" 2

	need ansible-playbook
	need ansible-inventory
	need ansible-galaxy
	need go
	need docker
	need make
	need npm
	need git
	need file
	need jq
	need ssh
	need virsh
	need python3

	if ! python3 -c 'import libvirt' >/dev/null 2>&1; then
		die "the python libvirt binding is missing: apt install python3-libvirt" 4
	fi
	if ! ansible-galaxy collection list community.libvirt 2>/dev/null | grep -q community.libvirt; then
		die "the community.libvirt collection is missing: ansible-galaxy collection install -r $ANSIBLE_DIR/requirements.yml" 4
	fi

	for dir in /var/lib/libvirt/images/mnt-lab /var/lib/libvirt/images/mnt-lab-base; do
		[ -w "$dir" ] || die "$dir is missing or not writable by $(id -un); run: $0 host-setup" 4
	done

	provision="$LAB_DIR/provision.yml"
	site="$ANSIBLE_DIR/site-lab.yml"
	[ -f "$provision" ] || die "deploy/ha/lab/provision.yml is missing (T027)" 4
	[ -f "$site" ] || die "deploy/ha/ansible/site-lab.yml is missing (T085)" 4

	info "provisioning the topology"
	ansible-playbook -i "$INVENTORY" "$provision" -e lab_state=present
	wait_for_ssh
	info "deploying mode $mode"
	ansible-playbook -i "$INVENTORY" "$site" -e "ha_mode=$mode"

	mkdir -p "$STATE_DIR"
	printf '%s\n' "$mode" >"$STATE_DIR/mode"

	info "checking the node clocks"
	check_clocks
	info "checking the bench"
	cmd_status
}

cmd_down() {
	[ $# -eq 0 ] || die "down takes no option" 2
	need ansible-playbook
	need jq

	provision="$LAB_DIR/provision.yml"
	[ -f "$provision" ] || die "deploy/ha/lab/provision.yml is missing (T027)" 4

	info "destroying the topology"
	ansible-playbook -i "$INVENTORY" "$provision" -e lab_state=absent
	rm -rf "$STATE_DIR"
	info "bench destroyed"
}

cmd_status() {
	as_json="no"
	while [ $# -gt 0 ]; do
		case "$1" in
		--json)
			as_json="yes"
			shift
			;;
		*) die "unknown option for status: $1" 2 ;;
		esac
	done

	need ansible-inventory
	need jq
	need ssh

	collect_status >"$TMP/status.json"
	if [ "$as_json" = "yes" ]; then
		cat "$TMP/status.json"
	else
		render_status <"$TMP/status.json"
	fi

	verdict=$(jq -r '.verdict' "$TMP/status.json")
	[ "$verdict" = "green" ] || exit 1
}

# Renders run.json as the Markdown report of contracts/run-report.md.
render_report() {
	run_json_file=$1
	cat >"$TMP/render.jq" <<'JQEOF'
def or_na(v): if v == null then "n/a" else (v | tostring) end;
def sec_s(v): if v == null then "n/a" else (((v / 1000) | tostring) + "s") end;
def bool_s(v): if v == null then "n/a" elif v == true then "yes" elif v == false then "no" else (v | tostring) end;
def cell($s; $m; f):
	if $s.measures == null then "n/a"
	elif ($s.measures[$m] | type) == "string" then ($s.measures[$m] | gsub("_"; " "))
	elif $s.measures[$m] == null then (if (($s.measures_declared // []) | index($m)) != null then "no result" else "-" end)
	else ($s.measures[$m] | f) end;
def list_s: if length == 0 then "none" else join(", ") end;
def node_cell($m):
	if $m == "local_restarts" then
		"\(.resource) \(if .count_min == .count_max then .count_min else "\(.count_min)-\(.count_max)" end) of limit \(or_na(.limit)), "
		+ "failover in \(.failovers)/\(.repetitions) (expected: \(if .failover_expected then "yes" else "no" end))"
	elif $m == "failover_count" or $m == "agent_watchdog_restart" or $m == "nodes_written" or $m == "divergence" then tostring
	elif $m == "detection_delay_s" then "\(.)s"
	elif $m == "fencing_outcome" then
		"fenced \(.fenced | list_s) (injected node in \(.holder_fenced // "n/a")/\(.repetitions)), failed \(.failed | list_s), started elsewhere before the fence \(.started_elsewhere_before_fence)/\(.repetitions)"
	elif $m == "primary_count" then
		"\(if .min == .max then .min else "\(.min)-\(.max)" end), two_primaries \(.two_primaries)"
	elif $m == "former_primary_rebuild" then
		"rebuilt \(.rebuilt)/\(.repetitions) by \(.methods | list_s), max \(or_na(.max_duration_s))s, primary before rebuild \(.primary_started_before_rebuild)/\(.repetitions)"
	elif $m == "loss_window" then
		"opened \(.opened)/\(.repetitions)" + (if .max_duration_s == null then "" else ", max \(.max_duration_s)s" end)
	elif $m == "crash_confirmed" then
		"confirmed \(.confirmed)/\(.repetitions), crashed \(.crashed | list_s), started before crash \(.started_before_crash | list_s)"
	else tostring end;

. as $r
| (if $r.mode.backend == null then $r.mode.replication else ($r.mode.backend + "/" + $r.mode.replication) end) as $mode_label
| (
    ["# HA bench run \($r.run_id)",
     "",
     "Mode: \($mode_label)",
     "",
     "## Versions",
     "",
     "- maintenant: \(or_na($r.versions.maintenant))",
     "- edition: \(or_na($r.versions.edition))",
     "- opensvc: \(or_na($r.versions.opensvc))",
     "- drbd: \(or_na($r.versions.drbd))",
     "- postgres: \(or_na($r.versions.postgres))",
     "- kernel: \(or_na($r.versions.kernel))",
     "- lab_commit: \(or_na($r.versions.lab_commit))",
     "",
     "## Settings",
     "",
     "- sqlite_synchronous: \(or_na($r.settings.sqlite_synchronous))",
     "- hb_timeout_s: \(or_na($r.settings.hb_timeout_s))",
     "- ready_period_s: \(or_na($r.settings.ready_period_s))",
     "- quorum: \(bool_s($r.settings.quorum))",
     "- stonith: \(bool_s($r.settings.stonith))",
     "- sync_standby: \(or_na($r.settings.sync_standby))",
     "",
     "## Scenarios",
     "",
     "| # | Scenario | Verdict | Repetitions | RTO min/p50/max | Writes lost/acked | Telemetry gap | Samples lost | Alerts induced | Agents back/expected | Not measured |",
     "|---|---|---|---|---|---|---|---|---|---|---|"]
    + [ $r.scenarios[] | . as $s |
        "| \(.id) | \(.name) | \(.verdict) | \(.repetitions) | "
        + (if .measures == null or .measures.rto_ms == null then "n/a"
           else "\(sec_s(.measures.rto_ms.min)) / \(sec_s(.measures.rto_ms.p50)) / \(sec_s(.measures.rto_ms.max))"
           end)
        + " | "
        + cell($s; "writes"; "\(.lost)/\(.ack)")
        + " | "
        + cell($s; "telemetry_gap_s"; "\(.)s")
        + " | "
        + cell($s; "telemetry_samples_lost"; tostring)
        + " | "
        + cell($s; "alerts_induced"; "agent=\(.agent_offline) hb=\(.heartbeat_overdue) endpoint=\(.endpoint_down) other=\(.other)")
        + " | "
        + cell($s; "agents"; "\(.reconnected)/\(.expected), max \(.max_reconnect_s)s"
            + (if (.new_agent_ids | length) > 0 then ", re-enrolled \(.new_agent_ids | length)" else "" end))
        + " | "
        + (if ((.not_measured // []) | length) > 0 then (.not_measured | join(", ")) else "-" end)
        + " |"
      ]
    + ( [$r.scenarios[] | select(.measures != null)
          | . as $s | [$node_set[] | select(. as $m | ($s.measures_declared // []) | index($m))] as $ms
          | select(($ms | length) > 0)
          | "| \(.id) | \(.name) | " + ([$ms[] as $m | "\($m): " + cell($s; $m; node_cell($m))] | join("; ")) + " |"] as $rows
        | if ($rows | length) > 0 then
            ["", "## Cluster measures", "", "| # | Scenario | Measures |", "|---|---|---|"] + $rows
          else [] end )
    + ( [$r.scenarios[] | select(.verdict == "not_applicable")] as $na
        | if ($na | length) > 0 then
            ["", "## Not applicable", ""] + [$na[] | "- \(.id) \(.name): \(.reason // "no reason given")"]
          else [] end )
    + ( [$r.scenarios[] | select(.verdict == "fail")] as $fails
        | if ($fails | length) > 0 then
            ["", "## Failures", ""]
            + ( [ $fails[] | (
                    ["### \(.id) \(.name)", ""]
                    + (if .reason then ["- " + .reason] else [] end)
                    + [ (.runs // [])[] | select(.verdict == "fail")
                        | "- repetition \(.repetition): \(.reasons | join("; "))" ]
                    + [""]
                  ) ] | add // [] )
          else [] end )
    + ["", "## Totals",
       "",
       "- scenarios: \($r.totals.scenarios)",
       "- pass: \($r.totals.pass)",
       "- fail: \($r.totals.fail)",
       "- not_applicable: \($r.totals.not_applicable)"]
  )
| .[]
JQEOF
	jq -r --argjson node_set "$NODE_MEASURES" -f "$TMP/render.jq" "$run_json_file"
}

cmd_report() {
	run_id=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--run)
			[ $# -ge 2 ] || die "--run takes a value" 2
			run_id=$2
			shift 2
			;;
		*) die "unknown option for report: $1" 2 ;;
		esac
	done

	need jq

	reports_dir="$HA_DIR/reports"
	if [ -z "$run_id" ]; then
		run_id=$(find "$reports_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -n 1)
		[ -n "$run_id" ] || die "no run found under $reports_dir" 2
	fi

	run_dir="$reports_dir/$run_id"
	run_json_file="$run_dir/run.json"
	[ -f "$run_json_file" ] || die "no run.json in $run_dir" 2

	render_report "$run_json_file" | tee "$run_dir/run.md"
}

preferred_node() {
	for name in $(group_hosts opensvc_cluster); do
		if [ "$(hostvar "$name" ha_preferred false)" = "true" ]; then
			printf '%s\n' "$name"
			return 0
		fi
	done
	first_cluster_host
}

# The preferred node is up to date when it is a standby that has caught up since
# its rebuild, streaming, synchronous, and zero bytes behind the primary.
postgres_copy_current() {
	preferred=$1
	primary=$2
	standby=$(ssh_to "$preferred" "$PG_STATE") || die "cannot read the PostgreSQL state of $preferred" 1
	printf '%s' "$standby" | jq -e '.role == "standby" and (.fenced | not) and .synced and .receiver == "streaming"' >/dev/null ||
		die "giveback refused: $preferred is not a caught-up standby ($(printf '%s' "$standby" | jq -c '{role, fenced, synced, receiver}'))" 1

	tries=$GIVEBACK_LAG_TRIES
	while :; do
		current=$(ssh_to "$primary" "$PG_STATE") || die "cannot read the PostgreSQL state of $primary" 1
		if printf '%s' "$current" | jq -e '.role == "primary" and .standby.state == "streaming" and .standby.sync_state == "sync" and .standby.lag_bytes == 0' >/dev/null; then
			return 0
		fi
		tries=$((tries - 1))
		if [ "$tries" -le 0 ]; then
			die "giveback refused: the copy on $preferred is not current ($(printf '%s' "$current" | jq -c '.standby'))" 1
		fi
		sleep 1
	done
}

# The preferred node's volume is up to date when it is a connected Secondary with
# nothing left to resynchronise from the holder.
drbd_copy_current() {
	preferred=$1
	holder=$2
	jq -e --arg p "$preferred" --arg h "$holder" '.nodes[] | select(.name == $p) | .drbd
		| .role == "Secondary" and .disk == "UpToDate"
		and any(.connections[]; .peer == $h and .state == "Connected" and .peer_disk == "UpToDate" and .out_of_sync_kib == 0)' \
		"$TMP/status-giveback.json" >/dev/null ||
		die "giveback refused: the volume on $preferred is not an up-to-date copy of $holder ($(jq -c --arg p "$preferred" '.nodes[] | select(.name == $p) | .drbd' "$TMP/status-giveback.json"))" 1
}

cmd_giveback() {
	[ $# -eq 0 ] || die "giveback takes no option" 2
	need ansible-inventory
	need jq
	need ssh

	mode=$(current_mode)
	[ "$mode" != "unknown" ] || die "no mode is deployed: run 'lab up' first" 2

	collect_status >"$TMP/status-giveback.json"
	holder=$(jq -r '.service.holders | if length == 1 then .[0] else empty end' "$TMP/status-giveback.json")
	[ -n "$holder" ] || die "giveback refused: the service is not held by exactly one node" 1
	preferred=$(preferred_node)
	[ "$holder" != "$preferred" ] || die "the service already runs on the preferred node $preferred" 1

	case "$mode" in
	ip-only) info "ip-only keeps no replicated data: nothing to compare before the giveback" ;;
	postgres/streaming) postgres_copy_current "$preferred" "$holder" ;;
	sqlite/drbd) drbd_copy_current "$preferred" "$holder" ;;
	*) die "giveback is not implemented for mode $mode yet" 3 ;;
	esac

	info "giving the service back to $preferred"
	# Without --wait: om3 wants the instance up at once, and the writes stall until the former primary streams again.
	ssh_to "$holder" "$OM ${LAB_SERVICE_NAME:-maintenant} giveback"
	if ! wait_for_status_green "$RUN_ALL_GREEN_TIMEOUT" "$RUN_ALL_GREEN_INTERVAL" "$TMP/status-giveback-after.json" "$preferred"; then
		render_status <"$TMP/status-giveback-after.json"
		die "the bench did not return to green after the giveback" 1
	fi
	render_status <"$TMP/status-giveback-after.json"
}

not_yet() {
	die "$1 is not implemented yet ($2)" 3
}

main() {
	[ $# -ge 1 ] || {
		usage
		exit 2
	}
	command=$1
	shift
	case "$command" in
	host-setup) cmd_host_setup "$@" ;;
	up) cmd_up "$@" ;;
	down) cmd_down "$@" ;;
	status) cmd_status "$@" ;;
	chaos) cmd_chaos "$@" ;;
	heal) cmd_heal "$@" ;;
	run-all) cmd_run_all "$@" ;;
	report) cmd_report "$@" ;;
	giveback) cmd_giveback "$@" ;;
	inventory) not_yet "inventory" "T080" ;;
	help | --help | -h)
		usage
		;;
	*)
		printf 'lab: unknown command: %s\n\n' "$command" >&2
		usage >&2
		exit 2
		;;
	esac
}

main "$@"
