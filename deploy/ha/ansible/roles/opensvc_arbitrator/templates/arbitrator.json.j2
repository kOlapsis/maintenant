{% set nodes = {} %}
{% for node in groups['opensvc_cluster'] %}
{% set _ = nodes.update({hostvars[node].ansible_host | default(node): node}) %}
{% endfor %}
{% set postgres = {'port': postgres_ha_port | int, 'database': 'postgres', 'user': postgres_ha_arbitrator_user, 'passfile': opensvc_arbitrator_pgpass} %}
{{ {'port': opensvc_arbitrator_port | int, 'path': opensvc_arbitrator_path, 'backend': opensvc_arbitrator_backend | trim, 'resource': drbd_resource, 'postgres': postgres, 'nodes': nodes} | to_nice_json }}
