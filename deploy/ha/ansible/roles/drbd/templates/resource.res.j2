# {{ ansible_managed }}
resource {{ drbd_resource }} {
	options {
		# OpenSVC promotes and demotes; opening the device never does.
		auto-promote no;
		quorum majority;
		on-no-quorum suspend-io;
	}

	net {
		protocol C;
		allow-two-primaries no;
		after-sb-0pri disconnect;
		after-sb-1pri disconnect;
		after-sb-2pri disconnect;
		rr-conflict disconnect;
		ping-int {{ drbd_ping_int_s }};
		ping-timeout {{ drbd_ping_timeout_ds }};
	}

	disk {
		disk-flushes yes;
		md-flushes yes;
		# The default 250 KiB/s floor under application writes outlasts the bench's return to green.
		c-min-rate 20M;
	}

	volume 0 {
		device {{ drbd_device }};
		disk {{ drbd_backing_device }};
		meta-disk internal;
	}
{% for node in drbd_nodes + [drbd_quorum_node] %}

	on {{ hostvars[node].ansible_facts.hostname }} {
		node-id {{ loop.index0 }};
		address {{ hostvars[node].ansible_host | default(node) }}:{{ drbd_port }};
{% if node == drbd_quorum_node %}
		volume 0 {
			disk none;
		}
{% endif %}
	}
{% endfor %}

	connection-mesh {
		hosts{% for node in drbd_nodes + [drbd_quorum_node] %} {{ hostvars[node].ansible_facts.hostname }}{% endfor %};
	}
}
